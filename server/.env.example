PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/tasa_crm
JWT_SECRET=change-me-super-secret-tasa-crm
JWT_EXPIRES_IN=12h
CLIENT_URL=http://localhost:5173

# ─── OTP sign-in ───────────────────────────────────────────────────────────
# The sign-in screen is OTP-only. This shared code is what staff type, and it
# is accepted in EVERY environment (production included) — set it to a value
# your team knows, or clear it to disable OTP sign-in entirely.
# DEV_OTP is a legacy alias still honoured if OTP_CODE is unset.
OTP_CODE=111111

# ─── Outbound call origination ─────────────────────────────────────────────
# 'browser' (DEFAULT) = the agent's own SIP.js softphone dials the student over
#   WSS. The API only validates + persists the Call record and stores the
#   browser-reported lifecycle. No PBX socket is opened and no AMI credentials
#   are needed.
# 'ami' = legacy server-side Asterisk AMI Originate/Hangup (see the AMI block
#   below). Only then are AMI_HOST / AMI_USER / AMI_SECRET load-bearing.
CALL_ORIGINATOR=browser
# Prefix the browser places in front of the stored student number so its INVITE
# matches the same PBX dialplan route the AMI flow used ('0' + digits). Set
# BROWSER_DIAL_PREFIX= (empty) to dial the stored number as-is.
BROWSER_DIAL_PREFIX=0

# RNR (ring no response) policy is calendar-day based and has NO configurable
# time window: a lead may receive at most 3 RNR attempts per calendar day
# (see server/src/services/rnr.service.js). After the 3rd attempt the lead is
# closed for TODAY and becomes available again on the next calendar day.

# ─── WhatsApp Business Platform (Meta Cloud API) — OUTBOUND ─────────────
# Foundation only: no sending or webhooks are wired yet. Fill these from
# Meta Business Suite > WhatsApp > API Setup. Keep secrets out of the repo.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
# Company display WhatsApp business number (the "from" number).
WHATSAPP_BUSINESS_PHONE=+918495970819
# Meta Graph API version for ALL WABA Graph calls (template metadata + direct
# template-message send). v19.0 is fully retired (May 21, 2026) — do not set it.
# Current stable: v25.0; available versions see developers.facebook.com/docs/graph-api/changelog.
WHATSAPP_GRAPH_API_VERSION=v25.0

# ─── GR Study Abroad WhatsApp Template API (OUTBOUND template sends) ────
# The encrypted API key is server-only (sent as the X-API-Key header) and is
# NEVER exposed to the frontend — the browser only calls /api/whatsapp/* .
# Fill these from the GR Study Abroad integration credentials.
WHATSAPP_TEMPLATE_API_URL=https://wa.grssl.com/inikaapi/send_template.php
WHATSAPP_TEMPLATE_API_KEY=
WHATSAPP_TEMPLATE_ORG=gr_study
WHATSAPP_TEMPLATE_LANGUAGE=en

# ─── Asterisk AMI telephony (LEGACY server-side origination) ────────────
# Only used when CALL_ORIGINATOR=ami. In the default browser-origination mode
# these are ignored entirely and the PBX is never contacted by the server.
# With CALL_ORIGINATOR=ami the server connects to the PBX's Manager Interface
# (TCP) and originates + hangs up calls itself. On Asterisk 18 the agent leg is
# a PJSIP WebRTC endpoint: the BROWSER registers its extension over a WebSocket
# and receives the leg that AMI Originate rings.
#
#   Start Call  → AMI `Originate`: ring <AMI_CHANNEL_TECH>/<agent ext>
#                 (browser softphone registered on the PBX), then the
#                 `gr-cloud-calling` dialplan dials the student number.
#   End Call    → AMI `Hangup` against the exact tracked agent channel.
#   Lifecycle   → AMI events are mapped onto the existing Call.status words:
#                 initiated → ringing → answered → connected →
#                 completed / failed / no-answer / busy / cancelled.
#
# AMI_HOST / AMI_USER / AMI_SECRET must all be set for AMI mode to be considered
# configured (the API returns 503 otherwise). Keep the AMI secret OUT of the
# repo. Never echo it anywhere.
AMI_HOST=172.16.10.19
AMI_PORT=5038
AMI_USER=
AMI_SECRET=
# Channel technology for the agent leg: PJSIP (Asterisk 13+/16/18/20 WebRTC)
# or SIP (legacy chan_sip PBXes).
AMI_CHANNEL_TECH=PJSIP
# Fallback agent extension that AMI Originate rings when the agent's user has
# no per-agent sipExtension. Per-agent PJSIP accounts live on the User record
# (sipExtension / sipPassword) and are served to the owning agent by
# GET /api/calls/sip-config.
AMI_EXTENSION=9999
# Dialplan context the student leg is dialed in (matches the Hathway PBX).
AMI_CONTEXT=gr-cloud-calling
# ─── Browser softphone WebSocket (where the browser REGISTERs) ─────────
# Asterisk HTTP WebSocket: ws://<pbx>:8088/ws (http + no certificate) or
# wss://<pbx>:8089/ws (TLS — needs a CA-trusted certificate; browsers refuse
# self-signed WebSocket certs). This is REQUIRED for browser-originated calls
# (CALL_ORIGINATOR=browser); leave it empty only for the legacy AMI mode.
SIP_WS_SERVER=wss://sip.grcti.com/ws
# Optional single-shared registration password fallback. Prefer per-agent
# User.sipPassword (see above); browsers must never hold these in the bundle.
SIP_PASSWORD=
# PBX dialplan knobs passed as var3 and var5 to the gr-cloud-calling 's'
# context, which dials the customer through a trunk. PBX-specific — fill from
# your Asterisk config. TASA never hardcodes these.
TRUNK=
ACCOUNT_PREFIX=
# Timeout (ms) for a single AMI action response.
AMI_TIMEOUT_MS=4000
# Keepalive Ping interval (ms) while the AMI socket is idle.
KEEPALIVE_MS=10000
# Reconnect delay (ms) after the AMI socket drops.
RECONNECT_MS=2000
# Cooldown (ms) after an AMI `Authentication failed` Login before retrying
# auth (default 300000 = 5 min). Prevents a tight login-retry loop on bad
# credentials while the CRM API stays up.
AMI_AUTH_RETRY_MS=300000

FREEPBX_PROVISIONING_URL=https://sip.grcti.com/provisioning
FREEPBX_PROVISIONING_TOKEN=
FREEPBX_PROVISIONING_TIMEOUT_MS=10000
SIP_DOMAIN=sip.grcti.com
