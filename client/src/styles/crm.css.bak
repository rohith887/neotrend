@font-face {
  font-family: 'Manrope';
  src: url('../assets/fonts/Manrope/Manrope-VariableFont_wght.ttf') format('truetype');
  font-weight: 200 800;
  font-style: normal;
  font-display: swap;
}

:root {
  --primary: #4154f1; --primary-hover: #3a48d9; --primary-soft: #eef0fd; --primary-border: #c7cbf9;
  --success: #2eca6a; --success-soft: #e8f9ef; --success-border: #b8eed0;
  --warning: #ff9f43; --warning-soft: #fff4e6; --warning-border: #ffd9a8;
  --danger: #ff4d4d; --danger-soft: #fff0f0; --danger-border: #ffb3b3;
  --info: #0dcaf0; --info-soft: #e3f8fc; --info-border: #a8e9f5;
  --violet: #6f42c1; --violet-soft: #f0ebfa;
  --bg: #f6f8fb; --surface: #fff; --surface-2: #f6f8fb; --surface-3: #eef0fd;
  --border: #e5e7eb; --border-strong: #d1d5db;
  --text-1: #212529; --text-2: #444; --text-3: #6c757d;
  --font: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --radius: 8px; --radius-sm: 6px; --radius-lg: 10px; --radius-pill: 999px;
  --shadow-xs: 0 1px 3px rgba(0,0,0,.06); --shadow-sm: 0 1px 4px rgba(0,0,0,.07);
  --shadow-md: 0 4px 12px rgba(0,0,0,.09); --shadow-lg: 0 8px 24px rgba(0,0,0,.11);
  --shadow-xl: 0 16px 40px rgba(0,0,0,.13);
  --transition-fast: 150ms ease; --transition: 250ms ease;
  --sh-header-h: 42px; --sh-sidebar-w: 224px; --sh-sidebar-c: 64px; --sh-footer-h: 38px;
  --sh-sidebar-t: width 200ms ease;
}

[data-theme='dark'] {
  --primary: #6c7cff; --primary-hover: #8a97ff; --primary-soft: rgba(108,124,255,.15); --primary-border: rgba(108,124,255,.35);
  --success: #34d399; --success-soft: rgba(52,211,153,.14); --success-border: rgba(52,211,153,.35);
  --warning: #fbbf24; --warning-soft: rgba(251,191,36,.14); --warning-border: rgba(251,191,36,.35);
  --danger: #f87171; --danger-soft: rgba(248,113,113,.14); --danger-border: rgba(248,113,113,.35);
  --info: #38bdf8; --info-soft: rgba(56,189,248,.14); --info-border: rgba(56,189,248,.35);
  --violet: #a78bfa; --violet-soft: rgba(167,139,250,.14);
  --bg: #0f1422; --surface: #1a2138; --surface-2: #222d45; --surface-3: #1d2840;
  --border: #2a3556; --border-strong: #3a4a6e;
  --text-1: #e8eaf2; --text-2: #9aa3bc; --text-3: #5e6f94;
  --shadow-xs: 0 1px 3px rgba(0,0,0,.3); --shadow-sm: 0 1px 4px rgba(0,0,0,.35);
  --shadow-md: 0 4px 12px rgba(0,0,0,.4); --shadow-lg: 0 8px 24px rgba(0,0,0,.5); --shadow-xl: 0 16px 40px rgba(0,0,0,.6);
}

/* Bootstrap theme integration */
body, .dropdown-menu, .modal-content, .form-control, .form-select { background-color: var(--surface); color: var(--text-1); }
body { background-color: var(--bg); font-family: var(--font); font-size: 14px; color: var(--text-2); }
:root {
  --bs-primary: var(--primary); --bs-primary-rgb: 65,84,241;
  --bs-body-color: var(--text-2); --bs-body-bg: var(--bg);
  --bs-secondary-color: var(--text-3); --bs-border-color: var(--border);
  --bs-font-sans-serif: var(--font); --bs-body-font-family: var(--font); --bs-border-radius: var(--radius-sm);
}
.btn-primary { --bs-btn-bg: var(--primary); --bs-btn-border-color: var(--primary); --bs-btn-hover-bg: var(--primary-hover); --bs-btn-hover-border-color: var(--primary-hover); --bs-btn-active-bg: var(--primary-hover); --bs-btn-active-border-color: var(--primary-hover); --bs-btn-disabled-bg: var(--primary); --bs-btn-disabled-border-color: var(--primary); }
.btn-light { --bs-btn-bg: var(--surface-2); --bs-btn-border-color: transparent; --bs-btn-hover-bg: var(--surface-3); --bs-btn-color: var(--text-2); --bs-btn-hover-color: var(--text-1); }
.btn-outline-light { --bs-btn-color: var(--text-2); --bs-btn-border-color: var(--border); --bs-btn-hover-bg: var(--surface-2); --bs-btn-hover-color: var(--text-1); }
.progress { --bs-progress-bg: var(--surface-2); --bs-progress-border-radius: var(--radius-pill); height: 8px; }
[data-theme='dark'] .btn-primary { --bs-btn-bg: #6c7cff; --bs-btn-border-color: #6c7cff; --bs-btn-hover-bg: #8a97ff; --bs-btn-hover-border-color: #8a97ff; }
.btn-outline-primary { --bs-btn-color: var(--primary); --bs-btn-border-color: var(--primary-border); --bs-btn-hover-bg: var(--primary-soft); --bs-btn-hover-border-color: var(--primary); --bs-btn-hover-color: var(--primary); --bs-btn-active-bg: var(--primary); --bs-btn-active-border-color: var(--primary); }
.btn-soft-primary { --bs-btn-color: var(--primary); --bs-btn-bg: var(--primary-soft); --bs-btn-border-color: transparent; --bs-btn-hover-bg: var(--primary-border); --bs-btn-hover-color: var(--primary); --bs-btn-active-bg: var(--primary-border); --bs-btn-active-color: var(--primary); }
.text-muted { color: var(--text-3) !important; }
.bg-white { background-color: var(--surface) !important; }
.border { border-color: var(--border) !important; }
.table { --bs-table-color: var(--text-2); --bs-table-bg: transparent; --bs-table-border-color: var(--border); }

/* --------------------------------------------------------------------------
   2. BASE
   -------------------------------------------------------------------------- */
*, *::before, *::after { box-sizing: border-box; }
html, body, #root { height: 100%; }
body { margin: 0; line-height: 1.6; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
a { color: var(--primary); text-decoration: none; transition: color var(--transition-fast); }
a:hover { color: var(--primary-hover); }
button { font-family: inherit; }
::selection { background: var(--primary-soft); color: var(--primary); }
:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: var(--radius-sm); }
* { scrollbar-width: thin; scrollbar-color: var(--border-strong) transparent; }
*::-webkit-scrollbar { width: 6px; height: 6px; }
*::-webkit-scrollbar-track { background: transparent; }
*::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: var(--radius-pill); }
*::-webkit-scrollbar-thumb:hover { background: var(--text-3); }

/* --------------------------------------------------------------------------
   3. APPLICATION SHELL
   .sh-shell (100vh) > .sh-header + .sh-body > .sh-sidebar + .sh-main
   Only .sh-main scrolls; header/sidebar/footer are pinned.
   -------------------------------------------------------------------------- */
.sh-shell { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.sh-header { flex-shrink: 0; height: var(--sh-header-h); background: var(--surface); border-bottom: 1px solid var(--border); display: flex; align-items: center; padding: 0 18px; gap: 16px; }
.sh-header__inner { width: 100%; display: flex; align-items: center; gap: 16px; }
.sh-header__side { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
.sh-header__toggle { border: 0; background: transparent; color: var(--text-2); font-size: 18px; padding: 6px; border-radius: var(--radius-sm); cursor: pointer; }
.sh-header__toggle:hover { background: var(--surface-2); color: var(--text-1); }
.sh-header__search { flex: 1; max-width: 480px; }
.sh-header__search .form-control { border-radius: var(--radius-pill); background: var(--surface-2); border-color: transparent; font-size: 13px; padding-left: 34px; }
.sh-header__right { margin-left: auto; display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.sh-header__actions { display: flex; align-items: center; gap: 8px; }
.sh-header__brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.sh-header__logo { height: 32px; width: auto; }
.sh-header__avatar { width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--violet)); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; flex-shrink: 0; }
.sh-header__user-info { min-width: 0; }
.sh-header__user-name { font-size: 13px; color: var(--text-1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sh-header__user-role { font-size: 11px; color: var(--text-3); }
.sh-header__chevron { color: var(--text-3); font-size: 11px; }
.sh-header__dd-profile { display: flex; align-items: center; gap: 10px; }
.sh-header__dd-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--violet)); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; }
.sh-header__dd-name { font-size: 14px; font-weight: 600; color: var(--text-1); }
.sh-header__dd-role { font-size: 12px; color: var(--text-3); }
.sh-body { flex: 1; display: flex; overflow: hidden; }
.sh-sidebar { width: var(--sh-sidebar-w); flex-shrink: 0; background: var(--surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; overflow-y: auto; transition: var(--sh-sidebar-t); }
.sh-shell--collapsed .sh-sidebar, .sh-sidebar--collapsed { width: var(--sh-sidebar-c); }
.sh-sidebar__top { padding: 14px 12px 10px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.sh-sidebar__brand { display: flex; align-items: center; gap: 10px; text-decoration: none; overflow: hidden; white-space: nowrap; }
.sh-sidebar__brand-tag { width: 34px; height: 34px; border-radius: var(--radius); background: linear-gradient(135deg, var(--primary), var(--violet)); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 15px; flex-shrink: 0; }
.sh-sidebar__nav { flex: 1; padding: 8px 12px; display: flex; flex-direction: column; gap: 2px; }
.sh-sidebar__group-label { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-3); padding: 10px 12px 4px; font-weight: 600; }
.sh-sidebar__item { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: var(--radius-sm); color: var(--text-2); font-size: 13px; font-weight: 500; text-decoration: none; white-space: nowrap; cursor: pointer; border: 0; background: transparent; width: 100%; text-align: left; }
.sh-sidebar__item:hover { background: var(--surface-2); color: var(--text-1); }
.sh-sidebar__item.is-active { background: var(--primary-soft); color: var(--primary); font-weight: 600; }
.sh-sidebar__icon { font-size: 16px; width: 22px; text-align: center; flex-shrink: 0; }
.sh-sidebar__label { flex: 1; overflow: hidden; text-overflow: ellipsis; transition: opacity var(--transition-fast); }
.sh-sidebar__badge { font-size: 11px; background: var(--danger); color: #fff; border-radius: var(--radius-pill); padding: 1px 7px; font-weight: 600; }
.sh-sidebar__bottom { border-top: 1px solid var(--border); padding: 12px; }
.sh-sidebar__user { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text-2); }
.sh-sidebar__user-avatar { width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0; }
.sh-sidebar__user-info { overflow: hidden; flex: 1; }
.sh-sidebar__user-name { font-size: 13px; font-weight: 600; color: var(--text-1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sh-sidebar__user-role { font-size: 11px; color: var(--text-3); }
.sh-sidebar__logout { color: var(--text-3); font-size: 15px; padding: 6px; border: 0; background: transparent; cursor: pointer; border-radius: var(--radius-sm); }
.sh-sidebar__logout:hover { color: var(--danger); background: var(--danger-soft); }
.sh-sidebar--collapsed .sh-sidebar__label, .sh-sidebar--collapsed .sh-sidebar__group-label, .sh-sidebar--collapsed .sh-sidebar__user-info, .sh-sidebar--collapsed .sh-sidebar__brand span { display: none; }
.sh-sidebar--collapsed .sh-sidebar__bottom, .sh-sidebar--collapsed .sh-sidebar__top { justify-content: center; }
.sh-sidebar--collapsed .sh-sidebar__item { justify-content: center; padding: 8px; }
.sh-sidebar--collapsed .sh-sidebar__badge { position: absolute; transform: translate(10px,-8px); }
.sh-main { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: var(--bg); }
.sh-content { flex: 1; overflow-y: auto; padding: 20px; }
.sh-footer { flex-shrink: 0; height: var(--sh-footer-h); background: var(--surface); border-top: 1px solid var(--border); display: flex; align-items: center; padding: 0 18px; }
.sh-footer__inner { width: 100%; display: flex; align-items: center; font-size: 12px; color: var(--text-3); }
.sh-footer__logo { height: 18px; width: auto; }
.sh-footer__powered, .sh-footer__copy { color: var(--text-3); }
.agent-shell { height: 100vh; display: flex; flex-direction: column; background: var(--bg); overflow: hidden; }
.agent-shell__main { flex: 1; min-height: 0; display: flex; flex-direction: column; overflow: hidden; }
.aw-root { padding: 18px; display: flex; flex-direction: column; gap: 16px; }
.aw-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
.aw-dot--available { background: var(--success); }
.aw-dot--break { background: var(--warning); }
.aw-dot--call { background: var(--danger); }
@keyframes dot-blink { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }

/* Agent shell — dashboard landing + workspace switcher */
.agent-nav { flex-shrink: 0; display: flex; align-items: center; gap: 6px; padding: 10px 18px 0; }
.agent-nav__tab { display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; border-radius: var(--radius-pill); border: 1px solid var(--border); background: var(--surface); color: var(--text-3); font-size: 13px; font-weight: 600; cursor: pointer; transition: color 150ms ease, border-color 150ms ease, background 150ms ease; }
.agent-nav__tab i { font-size: 14px; }
.agent-nav__tab:hover { color: var(--primary); border-color: var(--primary-border); }
.agent-nav__tab.is-active { background: var(--primary); border-color: var(--primary); color: #fff; }
.agent-dash { flex: 1; min-height: 0; overflow-y: auto; padding: 16px 18px 24px; }
.ad-fixed { max-height: 340px; overflow-y: auto; }

/* Work queue tiles */
.adq-tile { width: 100%; height: 100%; display: flex; align-items: center; gap: 10px; padding: 12px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface); cursor: pointer; text-align: left; transition: border-color 150ms ease, background 150ms ease; }
.adq-tile:hover { border-color: var(--primary-border); background: var(--primary-soft); }
.adq-tile__icon { width: 34px; height: 34px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; }
.adq-tile__icon--primary { background: var(--primary-soft); color: var(--primary); }
.adq-tile__icon--success { background: var(--success-soft); color: var(--success); }
.adq-tile__icon--warning { background: var(--warning-soft); color: var(--warning); }
.adq-tile__icon--danger { background: var(--danger-soft); color: var(--danger); }
.adq-tile__icon--info { background: var(--info-soft); color: var(--info); }
.adq-tile__icon--violet { background: var(--violet-soft); color: var(--violet); }
.adq-tile__body { display: flex; flex-direction: column; min-width: 0; }
.adq-tile__count { font-size: 18px; font-weight: 700; line-height: 1.1; color: var(--text-1); font-variant-numeric: tabular-nums; }
.adq-tile__label { font-size: 11.5px; color: var(--text-3); line-height: 1.25; }

/* Callback + lead rows */
.ad-cb, .ad-lead { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; transition: border-color 150ms ease, background 150ms ease; }
.ad-cb { cursor: pointer; }
.ad-cb:hover { border-color: var(--primary-border); background: var(--primary-soft); }
.ad-cb__who, .ad-lead__who { flex: 1; min-width: 0; }
.ad-cb__name, .ad-lead__name { display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--text-1); min-width: 0; }
.ad-cb__meta, .ad-lead__meta { font-size: 11.5px; color: var(--text-3); margin-top: 1px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
.ad-cb__time, .ad-lead__time { font-size: 11.5px; color: var(--text-3); white-space: nowrap; flex-shrink: 0; }
.ad-cb__prio, .ad-lead__prio { font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: var(--radius-pill); flex-shrink: 0; }
.ad-cb__prio--danger, .ad-lead__prio--danger { background: var(--danger-soft); color: var(--danger); }
.ad-cb__prio--warning, .ad-lead__prio--warning { background: var(--warning-soft); color: var(--warning); }
.ad-cb__prio--info, .ad-lead__prio--info { background: var(--info-soft); color: var(--info); }

/* KPI shortcut cards — one coherent premium CRM summary row. Six equal
   cards, each a compact icon + dominant number + muted label. Subtle border,
   very light shadow, restrained background; color is used only for the icon
   accent. Labels may wrap to two lines so nothing is ever cut off. */
.ad-kpi-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
.ad-kpi { position: relative; display: flex; align-items: center; gap: 12px; min-height: 84px; padding: 14px 16px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-xs); cursor: pointer; text-align: left; transition: border-color 150ms ease, background 150ms ease, box-shadow 150ms ease, transform 150ms ease; }
.ad-kpi:hover { border-color: var(--primary-border); box-shadow: var(--shadow-sm); transform: translateY(-1px); }
.ad-kpi.is-active { border-color: var(--primary); background: var(--primary-soft); box-shadow: var(--shadow-sm); }
.ad-kpi__icon { width: 36px; height: 36px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; }
.ad-kpi__icon--primary { background: var(--primary-soft); color: var(--primary); }
.ad-kpi__icon--success { background: var(--success-soft); color: var(--success); }
.ad-kpi__icon--warning { background: var(--warning-soft); color: var(--warning); }
.ad-kpi__icon--danger { background: var(--danger-soft); color: var(--danger); }
.ad-kpi__icon--info { background: var(--info-soft); color: var(--info); }
.ad-kpi__icon--violet { background: var(--violet-soft); color: var(--violet); }
.ad-kpi__cell { display: flex; flex-direction: column; justify-content: center; min-width: 0; }
.ad-kpi__value { font-size: 22px; font-weight: 700; line-height: 1.05; color: var(--text-1); font-variant-numeric: tabular-nums; letter-spacing: -.01em; }
.ad-kpi__label { font-size: 11.5px; color: var(--text-3); margin-top: 3px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.ad-kpi__tick { position: absolute; top: 6px; right: 8px; font-size: 10px; color: var(--primary); }
@media (max-width: 1399.98px) {
  .ad-kpi-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 767.98px) {
  .ad-kpi-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 479.98px) {
  .ad-kpi-grid { grid-template-columns: 1fr; }
}

/* Next Best Action card — compact CRM action card. White surface, subtle
   border + shadow, colored left accent bar only (never a full-width colored
   background). The accent is a CSS var per tone so the whole card animates
   cleanly when the action changes. */
.nba { position: relative; display: flex; align-items: center; gap: 14px; padding: 14px 16px 14px 20px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-xs); overflow: hidden; transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition); }
.nba--info    { --nba-accent: var(--info);    --nba-accent-soft: var(--info-soft);    --nba-accent-border: var(--info-border); }
.nba--warning { --nba-accent: var(--warning); --nba-accent-soft: var(--warning-soft); --nba-accent-border: var(--warning-border); }
.nba--success { --nba-accent: var(--success); --nba-accent-soft: var(--success-soft); --nba-accent-border: var(--success-border); }
.nba--neutral { --nba-accent: var(--text-3);  --nba-accent-soft: var(--surface-2);    --nba-accent-border: var(--border-strong); }
.nba:hover { border-color: var(--nba-accent-border); box-shadow: var(--shadow-md); transform: translateY(-1px); }
.nba__accent { position: absolute; left: 0; top: 10px; bottom: 10px; width: 4px; border-radius: 0 var(--radius-pill) var(--radius-pill) 0; background: var(--nba-accent); transition: background-color var(--transition); }
.nba__icon { width: 32px; height: 32px; border-radius: 9px; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; background: var(--nba-accent-soft); color: var(--nba-accent); transition: background-color var(--transition), color var(--transition); }
@keyframes nba-pulse { 0%, 100% { box-shadow: 0 0 0 0 var(--nba-accent-soft); } 50% { box-shadow: 0 0 0 7px var(--nba-accent-soft); } }
.nba--pulse .nba__icon { animation: nba-pulse 2.2s ease-in-out infinite; }
@media (prefers-reduced-motion: reduce) { .nba--pulse .nba__icon { animation: none; } }
.nba__body { flex: 1; min-width: 0; }
.nba__head { display: flex; align-items: center; gap: 8px; }
.nba__eyebrow { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--text-3); }
.nba__type { margin-left: auto; flex-shrink: 0; font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; padding: 2px 9px; border-radius: var(--radius-pill); background: var(--nba-accent-soft); color: var(--nba-accent); transition: background-color var(--transition), color var(--transition); }
.nba__title { font-size: 14.5px; font-weight: 700; color: var(--text-1); margin: 2px 0 0; letter-spacing: -.01em; line-height: 1.35; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.nba__meta { display: flex; align-items: center; flex-wrap: wrap; gap: 2px 6px; margin-top: 3px; font-size: 12px; color: var(--text-3); line-height: 1.5; }
.nba__student { color: var(--text-2); font-weight: 600; }
.nba__sep { color: var(--border-strong); }
.nba__timer { display: inline-flex; align-items: center; gap: 5px; font-variant-numeric: tabular-nums; color: var(--nba-accent); font-weight: 600; }
.nba__chip { font-size: 10px; font-weight: 600; padding: 0 8px; line-height: 1.7; }
.nba__cta { flex-shrink: 0; white-space: nowrap; }
.nba__cta.aw-btn--primary { box-shadow: 0 8px 20px rgba(65, 84, 241, .30); }
.nba__cta.aw-btn--primary:hover:not(:disabled) { box-shadow: 0 10px 24px rgba(65, 84, 241, .36); }
@media (max-width: 575px) {
  .nba { flex-wrap: wrap; padding: 14px 16px 14px 18px; }
  .nba__cta { width: 100%; }
}

/* KPI-shortcut section highlight */
.ad-section { scroll-margin-top: 12px; transition: border-color 150ms ease, box-shadow 150ms ease; }
.ad-section.is-active { border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-soft); }

/* Row action button + callback status tag inside ad-lead rows */
.ad-lead__action { flex-shrink: 0; white-space: nowrap; }
.ad-lead__tag { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding: 2px 6px; border-radius: var(--radius-pill); flex-shrink: 0; }
.ad-lead__tag--danger { background: var(--danger-soft); color: var(--danger); }
.ad-lead__tag--warning { background: var(--warning-soft); color: var(--warning); }

/* Performance summary table (agent dashboard) */
.ad-perf__scroll { max-height: 340px; overflow: auto; }
.ad-perf__table { width: 100%; min-width: 560px; margin-bottom: 0; }
.ad-perf .table { --bs-table-striped-bg: var(--surface-2); --bs-table-color: var(--text-2); font-size: 12.5px; }
.ad-perf thead th { position: sticky; top: 0; z-index: 1; background: var(--surface-2); color: var(--text-3); font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; padding: 9px 12px; border-bottom: 1px solid var(--border); white-space: nowrap; }
.ad-perf thead th:not(:first-child), .ad-perf tbody td { text-align: right; }
.ad-perf tbody th { color: var(--text-1); font-weight: 600; white-space: nowrap; }
.ad-perf tbody td, .ad-perf tbody th { padding: 8px 12px; }
.ad-perf tbody td { font-variant-numeric: tabular-nums; }
.ad-perf__micon { width: 24px; height: 24px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; margin-right: 8px; flex-shrink: 0; }
.ad-perf__micon--primary { background: var(--primary-soft); color: var(--primary); }
.ad-perf__micon--success { background: var(--success-soft); color: var(--success); }
.ad-perf__micon--info { background: var(--info-soft); color: var(--info); }
.ad-perf__micon--danger { background: var(--danger-soft); color: var(--danger); }
.ad-perf__states { padding: 16px 14px; }
.ad-perf__sk { display: grid; grid-template-columns: 1.5fr repeat(5, 1fr); gap: 10px; align-items: center; padding: 11px 12px; }
.ad-perf__sk .sk-line { margin-bottom: 0; }

/* Live queues (Ready to Call / Callbacks) on the agent dashboard */
.ad-qrow { border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; background: var(--surface); transition: border-color 150ms ease, background 150ms ease, box-shadow 150ms ease; }
.ad-qrow:hover { border-color: var(--primary-border); background: var(--primary-soft); box-shadow: var(--shadow-sm); }
.ad-qrow__top { display: flex; align-items: center; gap: 10px; }
.ad-qrow__who { flex: 1; min-width: 0; }
.ad-qrow__name { display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--text-1); min-width: 0; flex-wrap: wrap; }
.ad-qrow__name > span:first-child { overflow: hidden; text-overflow: ellipsis; }
.ad-qrow__meta { font-size: 11.5px; color: var(--text-3); margin-top: 2px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
.ad-qrow__meta span:first-child { font-variant-numeric: tabular-nums; }
.ad-qrow__badge { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding: 2px 6px; border-radius: var(--radius-pill); flex-shrink: 0; }
.ad-qrow__badge i { margin-right: 2px; }
.ad-qrow__badge--ready, .ad-qrow__badge--info { background: var(--info-soft); color: var(--info); }
.ad-qrow__badge--danger { background: var(--danger-soft); color: var(--danger); }
.ad-qrow__badge--warning { background: var(--warning-soft); color: var(--warning); }
.ad-qrow__chips { display: flex; align-items: center; gap: 6px; margin-top: 8px; flex-wrap: wrap; min-width: 0; }
.ad-qrow__remark { font-size: 11.5px; color: var(--text-3); font-style: italic; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px; max-width: 100%; }
.ad-qrow__foot { display: flex; align-items: center; justify-content: flex-end; gap: 8px; margin-top: 10px; }
.ad-qrow__cta { flex-shrink: 0; white-space: nowrap; }
.ad-qgroup { display: flex; flex-direction: column; gap: 8px; }
.ad-qgroup__head { display: flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--text-3); padding: 2px 2px 0; }
.ad-qgroup__head .badge { font-size: 10px; }
.ad-qgroup--danger .ad-qgroup__head > i { color: var(--danger); }
.ad-qgroup--warning .ad-qgroup__head > i { color: var(--warning); }
.ad-qgroup--info .ad-qgroup__head > i { color: var(--info); }
.ad-qsk { display: flex; flex-direction: column; gap: 10px; }
.ad-qsk__row { display: flex; align-items: center; gap: 10px; padding: 4px 2px; }
.ad-qsk__avatar { width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0; }

/* Compact empty state used inside the Ready to Call / queue panels */
.ad-qempty { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 4px; padding: 34px 16px; color: var(--text-3); }
.ad-qempty__icon { width: 44px; height: 44px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 17px; color: var(--primary); background: var(--primary-soft); box-shadow: inset 0 0 0 1px var(--primary-border); margin-bottom: 4px; }
.ad-qempty__title { font-size: 13.5px; font-weight: 600; color: var(--text-1); margin: 0; }
.ad-qempty__text { font-size: 12px; color: var(--text-3); margin: 0; max-width: 260px; line-height: 1.5; }

/* --------------------------------------------------------------------------
   4. PAGE HEADER / BREADCRUMB
   -------------------------------------------------------------------------- */
.page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 18px; }
.page-header__title { font-size: 20px; font-weight: 700; color: var(--text-1); margin: 0; letter-spacing: -.01em; }
.page-header__subtitle { font-size: 13px; color: var(--text-3); margin: 2px 0 0; }
.page-header__actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.breadcrumb { font-size: 12px; color: var(--text-3); display: flex; align-items: center; gap: 6px; list-style: none; padding: 0; margin: 0 0 8px; }
.breadcrumb a { color: var(--text-3); }
.breadcrumb a:hover { color: var(--primary); }
.breadcrumb .sep { color: var(--border-strong); }

/* --------------------------------------------------------------------------
   5. SHARED COMPONENTS
   -------------------------------------------------------------------------- */
/* Cards */
.card { --bs-card-border-color: var(--border); --bs-card-border-radius: var(--radius-lg); --bs-card-bg: var(--surface); --bs-card-cap-bg: transparent; --bs-card-spacer-y: 18px; --bs-card-spacer-x: 18px; box-shadow: var(--shadow-xs); }
.card-title { font-size: 15px; font-weight: 600; color: var(--text-1); }
.card-subtitle { font-size: 12.5px; color: var(--text-3); }
.card-hover { transition: box-shadow var(--transition-fast), transform var(--transition-fast); }
.card-hover:hover { box-shadow: var(--shadow-md); transform: translateY(-1px); }

/* Metric card */
.metric-card__head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.metric-card__title { font-size: 12px; font-weight: 500; color: var(--text-3); margin: 0; }
.metric-card__sub { font-size: 11px; color: var(--text-3); margin: 0; }
.metric-card__value { font-size: 24px; font-weight: 700; color: var(--text-1); letter-spacing: -.01em; line-height: 1.2; }
.metric-card__delta { font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; }
.metric-card__delta.is-up { color: var(--success); }
.metric-card__delta.is-down { color: var(--danger); }
.metric-card__icon { width: 38px; height: 38px; border-radius: var(--radius); display: flex; align-items: center; justify-content: center; font-size: 16px; background: var(--surface-2); color: var(--primary); flex-shrink: 0; }
.metric-card__footer { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text-3); }
.metric-card__spark { width: 88px; height: 32px; margin-left: auto; flex-shrink: 0; }
.metric-card__spark svg { width: 100%; height: 100%; display: block; }
.metric-card__spark .sparkline { fill: none; stroke: var(--primary); stroke-width: 2; }
.metric-card__tone-primary { --t: var(--primary); --t-soft: var(--primary-soft); }
.metric-card__tone-success { --t: var(--success); --t-soft: var(--success-soft); }
.metric-card__tone-warning { --t: var(--warning); --t-soft: var(--warning-soft); }
.metric-card__tone-danger { --t: var(--danger); --t-soft: var(--danger-soft); }
.metric-card__tone-info { --t: var(--info); --t-soft: var(--info-soft); }
.metric-card__tone-violet { --t: var(--violet); --t-soft: var(--violet-soft); }

/* Status chip */
.chip { display: inline-flex; align-items: center; gap: 6px; padding: 2px 10px; border-radius: var(--radius-pill); font-size: 12px; font-weight: 500; white-space: nowrap; line-height: 1.7; }
.chip.is-success, .chip--success { background: var(--success-soft); color: var(--success); }
.chip.is-warning, .chip--warning { background: var(--warning-soft); color: var(--warning); }
.chip.is-danger, .chip--danger { background: var(--danger-soft); color: var(--danger); }
.chip.is-info, .chip--info { background: var(--info-soft); color: var(--info); }
.chip.is-primary, .chip--primary { background: var(--primary-soft); color: var(--primary); }
.chip.is-violet, .chip--violet { background: var(--violet-soft); color: var(--violet); }
.chip.is-neutral, .chip--neutral { background: var(--surface-2); color: var(--text-3); }
.chip__dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; flex-shrink: 0; }

/* Avatar */
.avatar { position: relative; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: #fff; font-weight: 600; flex-shrink: 0; --av-a: var(--primary); --av-b: var(--violet); background: linear-gradient(135deg, var(--av-a), var(--av-b)); }
.avatar--xs { width: 24px; height: 24px; font-size: 11px; }
.avatar--sm { width: 32px; height: 32px; font-size: 13px; }
.avatar--md { width: 40px; height: 40px; font-size: 15px; }
.avatar--lg { width: 56px; height: 56px; font-size: 20px; }
.avatar--dot { position: relative; }
.avatar__dot { position: absolute; bottom: 1px; right: 1px; width: 10px; height: 10px; border-radius: 50%; background: var(--text-3); border: 2px solid var(--surface); }
.avatar__dot--success { background: var(--success); }
.avatar__dot--warning { background: var(--warning); }
.avatar__dot--call { background: var(--danger); }

/* Icon button */
.icon-btn { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); border: 1px solid transparent; background: transparent; color: var(--text-3); font-size: 14px; cursor: pointer; transition: background var(--transition-fast), color var(--transition-fast); }
.icon-btn:hover { background: var(--surface-2); color: var(--text-1); }
.icon-btn.is-primary { color: var(--primary); }
.icon-btn.is-danger { color: var(--danger); }
.icon-btn.is-danger:hover { background: var(--danger-soft); }

/* Skeleton */
.sk-pulse { position: relative; overflow: hidden; background: var(--surface-2); }
.sk-pulse::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,.5), transparent); animation: sk-shimmer 1.4s infinite; }
[data-theme='dark'] .sk-pulse::after { background: linear-gradient(90deg, transparent, rgba(255,255,255,.06), transparent); }
@keyframes sk-shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
.sk-line { height: 14px; border-radius: var(--radius-sm); margin-bottom: 8px; }
.sk-circle { width: 38px; height: 38px; border-radius: 50%; }

/* Empty state */
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 40px 20px; text-align: center; }
.empty-state__art { width: 96px; height: 96px; color: var(--primary); margin-bottom: 4px; }
.empty-state__title { font-size: 15px; font-weight: 600; color: var(--text-1); margin: 0; }
.empty-state__text { font-size: 13px; color: var(--text-3); margin: 0; max-width: 340px; }

/* Timeline (custom vertical stream) */
.timeline { position: relative; padding-left: 26px; margin: 0; list-style: none; }
.timeline::before { content: ''; position: absolute; left: 8px; top: 6px; bottom: 6px; width: 2px; background: var(--border); }
.timeline__item { position: relative; padding: 0 0 18px; }
.timeline__item:last-child { padding-bottom: 0; }
.timeline__dot { position: absolute; left: -26px; top: 2px; width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 8px; background: var(--surface); border: 2px solid var(--tl-tone, var(--primary)); color: var(--tl-tone, var(--primary)); z-index: 1; }
.timeline__item-tone-success { --tl-tone: var(--success); }
.timeline__item-tone-warning { --tl-tone: var(--warning); }
.timeline__item-tone-danger { --tl-tone: var(--danger); }
.timeline__item-tone-info { --tl-tone: var(--info); }
.timeline__item-tone-violet { --tl-tone: var(--violet); }
.timeline__item-tone-primary { --tl-tone: var(--primary); }
.timeline__item-tone-neutral { --tl-tone: var(--text-3); }
.timeline__title { font-size: 13px; font-weight: 600; color: var(--text-1); }
.timeline__detail { font-size: 12.5px; color: var(--text-2); margin-top: 1px; }
.timeline__time { font-size: 11.5px; color: var(--text-3); margin-top: 3px; display: flex; align-items: center; gap: 4px; }
.ds-timeline .timeline__item { padding-bottom: 12px; }
.ds-timeline .timeline__item:last-child { padding-bottom: 0; }
.ds-timeline .timeline__dot { top: 1px; width: 18px; height: 18px; font-size: 8px; }
.ds-timeline .timeline__title { font-size: 13px; font-weight: 700; }
.ds-timeline .timeline__detail { font-size: 12px; font-weight: 500; margin-top: 2px; }
.ds-timeline .timeline__detail b { color: var(--text-1); font-weight: 700; }
.ds-timeline .timeline__time { font-size: 11px; font-weight: 500; margin-top: 3px; }
.ds-timeline .timeline__item { border-radius: 8px; padding-left: 6px; margin-left: -6px; transition: background 150ms ease; animation: ds-timeline-in 240ms ease both; }
.ds-timeline .timeline__item:hover { background: var(--surface-2); }
@keyframes ds-timeline-in { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }

/* Tooltip (custom svg chart) */
.chart-tooltip { position: fixed; z-index: 1080; background: var(--text-1); color: var(--surface); border-radius: var(--radius-sm); padding: 6px 10px; font-size: 12px; pointer-events: none; box-shadow: var(--shadow-md); white-space: nowrap; }
.chart-legend { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; font-size: 12px; color: var(--text-3); }
.chart-legend__item { display: inline-flex; align-items: center; gap: 6px; }
.chart-legend__swatch { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }

/* Toasts (custom renderer, Bootstrap iconography) */
.toast-viewport { position: fixed; top: 60px; right: 18px; z-index: 1080; display: flex; flex-direction: column; gap: 10px; width: 340px; max-width: calc(100vw - 36px); }
.ec-toast { display: flex; align-items: flex-start; gap: 10px; background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--primary); border-radius: var(--radius); box-shadow: var(--shadow-md); padding: 12px 14px; animation: toast-in 200ms ease; }
.ec-toast--success { border-left-color: var(--success); }
.ec-toast--danger { border-left-color: var(--danger); }
.ec-toast--warning { border-left-color: var(--warning); }
.ec-toast--info { border-left-color: var(--info); }
.ec-toast__icon { font-size: 16px; flex-shrink: 0; color: var(--text-3); }
.ec-toast__icon--success { color: var(--success); }
.ec-toast__icon--danger { color: var(--danger); }
.ec-toast__icon--warning { color: var(--warning); }
.ec-toast__icon--info { color: var(--info); }
.ec-toast__body { flex: 1; min-width: 0; }
.ec-toast__title { font-size: 13px; font-weight: 600; color: var(--text-1); }
.ec-toast__msg { font-size: 12.5px; color: var(--text-3); margin: 0; word-break: break-word; white-space: pre-line; }
.ec-toast__close { border: 0; background: transparent; color: var(--text-3); cursor: pointer; padding: 2px; font-size: 14px; line-height: 1; }
.ec-toast__close:hover { color: var(--text-1); }
@keyframes toast-in { from { opacity: 0; transform: translateX(12px); } to { opacity: 1; transform: none; } }

/* Dialog (Bootstrap modal wrapper) */
.ec-dialog__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
.ec-dialog__title { font-size: 16px; font-weight: 700; color: var(--text-1); margin: 0; }
.ec-dialog__sub { font-size: 12.5px; color: var(--text-3); margin: 2px 0 0; }

/* Sign-in page — light, enterprise login experience (fixed light palette so
   the login surface stays white even when the app theme is dark). */
.signin-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 20px;
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #ffffff 0%, #f2f6fd 100%);
}
.signin-page::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 760px;
  height: 760px;
  transform: translate(-50%, -56%);
  background: radial-gradient(circle, rgba(65, 84, 241, 0.08) 0%, rgba(65, 84, 241, 0.02) 45%, transparent 70%);
  pointer-events: none;
}
.signin-card {
  position: relative;
  width: 100%;
  max-width: 480px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
  padding: 24px 40px 20px;
  animation: signin-fade-in 0.45s ease both;
}
@keyframes signin-fade-in {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: none; }
}
.signin-brand { text-align: center; margin-bottom: 0; }
.signin-logo {
  display: inline-block;
  width: 180px;
  height: 44px;
  object-fit: cover;
  object-position: center;
  margin-bottom: 24px;
}
.signin-title { font-size: 28px; font-weight: 700; letter-spacing: -0.02em; color: #111827; margin: 0 0 10px; }
.signin-subtitle { font-size: 15.5px; color: #6b7280; margin: 0 0 28px; }
.signin-portal-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: #4154f1;
  background: #eef0fd;
  border: 1px solid #c7cbf9;
  border-radius: 999px;
  padding: 5px 14px;
}
.signin-label { font-size: 13.5px; font-weight: 600; color: #374151; margin-bottom: 8px; }
.signin-card .mb-3 { margin-bottom: 20px !important; }
.signin-input {
  height: 52px;
  font-size: 14.5px;
  color: #111827;
  background: #ffffff;
  border: 1px solid #d1d5db;
  border-radius: 12px !important;
  padding: 0 16px;
  transition: border-color 150ms ease, box-shadow 150ms ease, background-color 150ms ease;
}
.signin-input::placeholder { color: #9ca3af; }
.signin-input:focus {
  border-color: #4154f1;
  box-shadow: 0 0 0 4px rgba(65, 84, 241, 0.14);
  background: #ffffff;
}
.signin-input.is-invalid { border-color: #ff4d4d; }
.signin-field { position: relative; }
.signin-field .signin-input { padding-right: 48px; }
.signin-eye {
  position: absolute;
  top: 50%;
  right: 6px;
  transform: translateY(-50%);
  width: 40px;
  height: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  border-radius: 10px;
  color: #6b7280;
  cursor: pointer;
  transition: background-color 150ms ease, color 150ms ease;
}
.signin-eye:hover { background: #f3f4f6; color: #374151; }
.signin-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: -6px 0 26px;
}
.signin-remember { display: flex; align-items: center; gap: 8px; margin: 0; padding-left: 0; }
.signin-remember .form-check-input {
  width: 17px;
  height: 17px;
  margin: 0;
  border-radius: 5px;
  border: 1px solid #d1d5db;
  background-color: #ffffff;
  cursor: pointer;
  transition: background-color 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
}
.signin-remember .form-check-input:checked { background-color: #4154f1; border-color: #4154f1; }
.signin-remember .form-check-input:focus { border-color: #4154f1; box-shadow: 0 0 0 3px rgba(65, 84, 241, 0.14); }
.signin-remember-label { font-size: 14px; font-weight: 500; color: #374151; cursor: pointer; }
.signin-forgot {
  font-size: 13.5px;
  font-weight: 600;
  color: #4154f1;
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
  transition: color 150ms ease;
}
.signin-forgot:hover { color: #3a48d9; text-decoration: underline; }
.signin-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  height: 50px;
  font-size: 15px;
  font-weight: 600;
  color: #ffffff;
  border: none;
  border-radius: 12px;
  background: linear-gradient(180deg, #5567ff 0%, #4154f1 55%, #3a48d9 100%);
  box-shadow: 0 4px 14px rgba(65, 84, 241, 0.25);
  transition: transform 150ms ease, box-shadow 150ms ease, filter 150ms ease, opacity 150ms ease;
}
.signin-btn:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 8px 22px rgba(65, 84, 241, 0.35);
  filter: brightness(1.03);
}
.signin-btn:active:not(:disabled) { transform: translateY(0); }
.signin-btn:disabled { opacity: 0.65; box-shadow: none; }
.signin-footer {
  margin-top: 30px;
  padding-top: 18px;
  border-top: 1px solid #eef0f3;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-size: 12.5px;
  color: #9ca3af;
}
.signin-footer-powered { font-size: 12.5px; color: #9ca3af; }
.signin-footer-logo {
  width: auto;
  height: 16px;
  object-fit: contain;
}
.signin-footer-dot { opacity: 0.6; }
@media (max-width: 480px) {
.signin-page { padding: 20px 16px; }
.signin-card { padding: 22px 22px 16px; }
.signin-logo { width: 150px; height: 36px; margin-bottom: 22px; }
.signin-title { font-size: 25px; margin: 0 0 10px; }
.signin-row { margin: -6px 0 22px; }
}

/* --------------------------------------------------------------------------
   6. TABLE EXTENSIONS (thin hooks on top of Bootstrap .table)
   -------------------------------------------------------------------------- */.e-table-wrap { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--surface); box-shadow: var(--shadow-xs); }
.e-table-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 16px; border-bottom: 1px solid var(--border); }
.e-table-toolbar__title { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--text-1); }
.e-table-toolbar__count { font-size: 11px; font-weight: 600; color: var(--text-3); background: var(--surface-2); border-radius: var(--radius-pill); padding: 1px 8px; }
.e-table-toolbar__actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.e-table-scroll { overflow-x: auto; }
.e-table { --bs-table-bg: transparent; margin-bottom: 0; font-family: var(--font); }
.e-table thead th { background: var(--surface-2); font-size: 11.5px; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: .04em; padding: 10px 14px; white-space: nowrap; border-bottom: 1px solid var(--border); }
.e-table thead th.sortable { cursor: pointer; }
.e-table thead th.sortable:hover { color: var(--primary); }
.e-table thead th.is-sorted { color: var(--primary); }
.e-table thead th { position: sticky; top: 0; z-index: 2; }
.e-table--no-sticky thead th { position: static; }
.e-table tbody td { padding: 10px 14px; font-size: 13.5px; vertical-align: middle; border-bottom: 1px solid var(--border); }
.e-table tbody tr:last-child td { border-bottom: 0; }
.e-table tbody tr:hover { background: var(--surface-2); }
.e-table--dense thead th, .e-table--dense tbody td { padding: 6px 12px; }
.e-table .is-selected { background: var(--primary-soft) !important; }
.e-table .is-expandable { cursor: pointer; }
.e-table-check { width: 38px; }
.sort-icon { margin-left: 4px; font-size: 11px; opacity: .6; }
.col-num, .cell-num { text-align: right; font-variant-numeric: tabular-nums; }
.cell-strong { font-weight: 600; color: var(--text-1); }
.cell-muted { color: var(--text-3); }
.user-link { color: var(--primary); font-weight: 600; }
.user-link:hover { color: var(--primary-hover); text-decoration: underline; }
.row-actions { display: flex; justify-content: flex-end; }

/* Bootstrap pagination */
.pagination { --bs-pagination-color: var(--text-2); --bs-pagination-bg: var(--surface); --bs-pagination-border-color: var(--border); --bs-pagination-hover-color: var(--primary); --bs-pagination-hover-bg: var(--surface-2); --bs-pagination-hover-border-color: var(--border-strong); --bs-pagination-focus-color: var(--primary); --bs-pagination-focus-bg: var(--surface-2); --bs-pagination-active-bg: var(--primary); --bs-pagination-active-border-color: var(--primary); --bs-pagination-disabled-bg: var(--surface-2); --bs-pagination-disabled-color: var(--text-3); }
.page-link { font-size: 12.5px; }

/* Dropdown (Bootstrap) */
.dropdown-menu { --bs-dropdown-link-color: var(--text-2); --bs-dropdown-link-hover-color: var(--text-1); --bs-dropdown-link-hover-bg: var(--surface-2); --bs-dropdown-link-active-color: #fff; --bs-dropdown-link-active-bg: var(--primary); min-width: 180px; border-color: var(--border); box-shadow: var(--shadow-md); }
/* CSS-only dropdowns (no data-bs-popper): anchor the menu to the trigger so
   end-aligned menus open LEFTWARD (never past the right edge of the container) */
.dropdown-menu-start { left: 0; right: auto; }
.dropdown-menu-end { left: auto; right: 0; }
.dropdown-item { font-size: 13px; }
.dropdown-header { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; }
.dropdown-divider { border-color: var(--border); }

/* Dialog (CSS-only Bootstrap modal) */
.modal.d-block { display: block !important; background: rgba(15,20,40,.45); }
.modal-content { border: 1px solid var(--border); box-shadow: var(--shadow-lg); }
.modal-title { font-size: 16px; font-weight: 700; color: var(--text-1); }
.modal-header, .modal-footer { border-color: var(--border); }

/* --------------------------------------------------------------------------
   7. KEYFRAMES / MISC
   -------------------------------------------------------------------------- */
.min-w-0 { min-width: 0; }
.text-strong { color: var(--text-1); }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes fadeUp { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
.fade-up { animation: fadeUp 200ms ease; }

/* --------------------------------------------------------------------------
   8. AGENT WORKSPACE PANELS (thin custom bits on Bootstrap cards)
   -------------------------------------------------------------------------- */
.aw-card__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 18px; border-bottom: 1px solid var(--border); background: var(--surface-2); flex-shrink: 0; }
.aw-card__lead { min-width: 0; }
.aw-card__title { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; color: var(--text-1); margin: 0; }
.aw-card__title i { color: var(--primary); }
.aw-card__desc { font-size: 12px; color: var(--text-3); margin: 2px 0 0; }
.aw-card__body { flex: 1; min-height: 0; overflow-y: auto; padding: 16px 18px; }
.aw-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 48px 24px; gap: 10px; color: var(--text-3); }
.aw-empty i { font-size: 40px; opacity: .35; }
.aw-empty__title { font-size: 14px; font-weight: 600; color: var(--text-2); margin: 0; }
.aw-empty__sub { font-size: 13px; color: var(--text-3); max-width: 280px; margin: 0; }
.aw-snap__name { font-size: 16px; font-weight: 700; color: var(--text-1); margin: 0 0 8px; }
.aw-snap { display: flex; flex-direction: column; }
.aw-snap__row { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding: 4px 0; border-bottom: 1px dashed var(--border); font-size: 12.5px; }
.aw-snap__k { color: var(--text-3); font-weight: 500; flex-shrink: 0; }
.aw-snap__v { color: var(--text-1); font-weight: 600; text-align: right; word-break: break-word; }
.aw-timeline { display: flex; flex-direction: column; min-height: 0; flex: 1 1 0; border-top: 1px solid var(--border); margin-top: 14px; padding-top: 12px; }
.aw-timeline__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-3); padding-bottom: 8px; flex-shrink: 0; }
.aw-timeline__list { list-style: none; margin: 0; padding: 0; flex: 1 1 0; min-height: 0; overflow-y: auto; }
.aw-tl-item { padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); margin-bottom: 10px; }
.aw-tl-item__top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.aw-tl-item__time { font-size: 11px; color: var(--text-3); white-space: nowrap; }
.aw-tl-item__remarks { font-size: 12.5px; color: var(--text-1); margin: 6px 0 0; white-space: pre-wrap; }
.aw-tl-item__meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
.chip--disp { padding: 2px 10px; border: 1px solid var(--border); border-radius: var(--radius-pill); background: var(--surface-2); font-size: 12px; font-weight: 600; line-height: 1.4; }
.aw-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
.aw-form-grid .aw-span2 { grid-column: 1 / -1; }
.aw-form-footer { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 18px; }
.break-type__card { border: 1.5px solid var(--border); border-radius: var(--radius); background: var(--surface); color: var(--text-2); }
.break-type__card:hover { border-color: var(--primary-border); color: var(--primary); }
.break-type__card i { color: var(--text-3); }
.break-type input:checked + .break-type__card { border-color: var(--primary); background: var(--primary-soft); color: var(--primary); box-shadow: 0 0 0 3px rgba(65,84,241,.14); }
.break-type input:checked + .break-type__card i { color: var(--primary); }
@media (max-width: 575.98px) { .aw-form-grid { grid-template-columns: 1fr; } .aw-card__head, .aw-card__body { padding-left: 14px; padding-right: 14px; } }

/* 9. LEAD MANAGEMENT + DASHBOARD WIDGET HOOKS (ported, compact) */
.page-loader { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--bg); }
.spinner, .spinner--dark { width: 34px; height: 34px; border-radius: 50%; border: 3px solid var(--surface-3); border-top-color: var(--primary); animation: spin .8s linear infinite; }
.chip--pulse .chip__dot { animation: dot-blink 1.4s ease-in-out infinite; }
.aw-badge--sm { font-size: 10px; font-weight: 600; padding: 3px 7px; }
.signin-demo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 20px; }
.um-stat { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 7px 9px; display: flex; flex-direction: column; gap: 2px; }
.um-stat__label { font-size: 10px; color: var(--text-3); text-transform: uppercase; letter-spacing: .05em; } .um-stat__value { font-size: 14px; font-weight: 700; color: var(--text-1); }
.um-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; } .um-list__item { display: flex; align-items: flex-start; gap: 9px; }
.um-list__icon { width: 26px; height: 26px; flex: 0 0 26px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); font-size: 11px; background: var(--surface-2); color: var(--text-3); }
.um-list__icon--primary { color: var(--primary); background: var(--primary-soft); } .um-list__icon--warning { color: var(--warning); background: var(--warning-soft); }
.um-list__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.um-list__primary { font-size: 12.5px; color: var(--text-1); font-weight: 600; } .um-list__primary .um-list__detail { color: var(--text-3); font-weight: 500; }
.um-list__time { font-size: 11px; color: var(--text-3); } .um-detail__empty { font-size: 12px; color: var(--text-3); margin: 0; }
.lat-action-btn { display: inline-flex; align-items: center; gap: 3px; padding: 3px 7px; font-size: 11.5px; font-weight: 500; color: var(--primary); background: none; border: none; border-radius: var(--radius-sm); cursor: pointer; white-space: nowrap; }
.lat-action-btn i { font-size: 11px; } .lat-action-btn:hover { background: var(--primary-soft); }
.lat-status { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-1); } .lat-status__dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; background: var(--text-3); }
.lat-status__dot.is-success { background: var(--success); } .lat-status__dot.is-danger { background: var(--danger); }
.aw-card { display: flex; flex-direction: column; min-height: 0; }
.aw-kv { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding: 3px 0; border-bottom: 1px dashed var(--border); font-size: 12.5px; }
.aw-kv__key { color: var(--text-3); font-weight: 500; flex-shrink: 0; } .aw-kv__val { color: var(--text-1); font-weight: 600; text-align: right; word-break: break-word; }
.aw-section { display: flex; flex-direction: column; gap: 8px; } .aw-section__label { display: flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-3); padding-bottom: 6px; border-bottom: 1px solid var(--border); }
.lm-aura { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 600; color: var(--primary); background: var(--primary-soft); border: 1px solid var(--primary-border); padding: 3px 9px; border-radius: var(--radius-pill); } .lm-aura i { font-size: 11px; }
.lm-kv-grid { display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 24px; }
.lead-stages { display: flex; align-items: flex-start; margin-top: 16px; } .lead-stage { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 6px; position: relative; }
.lead-stage::before { content: ''; position: absolute; top: 9px; left: -50%; right: 50%; height: 2px; background: var(--border); }
.lead-stage:first-child::before { display: none; } .lead-stage.is-done::before { background: var(--success); }
.lead-stage__dot { width: 20px; height: 20px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; color: var(--text-3); background: var(--surface-2); border: 2px solid var(--border); flex-shrink: 0; z-index: 1; }
.lead-stage.is-done .lead-stage__dot { background: var(--success); border-color: var(--success); color: #fff; } .lead-stage.is-active .lead-stage__dot { border-color: var(--primary); color: var(--primary); box-shadow: 0 0 0 4px var(--primary-soft); }
.lead-stage__label { font-size: 10.5px; font-weight: 600; color: var(--text-3); text-align: center; line-height: 1.3; } .lead-stage.is-done .lead-stage__label, .lead-stage.is-active .lead-stage__label { color: var(--text-1); }
.lead-empty { font-size: 12px; color: var(--text-3); margin: 0; }
.lead-note { padding: 9px 11px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-2); margin-bottom: 8px; } .lead-note:last-child { margin-bottom: 0; }
.lead-note.lm-remark-latest { border-color: var(--primary-border); background: var(--primary-soft); } .lead-note__text { font-size: 13px; color: var(--text-1); line-height: 1.45; } .lead-note__meta { display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--text-3); margin-top: 6px; }
.lead-agent-box { display: flex; align-items: center; gap: 10px; } .lead-agent-box__initials { width: 38px; height: 38px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: var(--primary); background: var(--primary-soft); flex-shrink: 0; } .lead-agent-box__body { flex: 1; min-width: 0; } .lead-agent-box__name { font-size: 13.5px; font-weight: 600; color: var(--text-1); } .lead-agent-box__meta { font-size: 11.5px; color: var(--text-3); }
.lm-call { border: 1px solid var(--border); border-radius: var(--radius); padding: 12px 14px; background: var(--surface-2); margin-bottom: 12px; }
.lm-call__head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; } .lm-call__num { font-size: 13px; font-weight: 700; color: var(--text-1); } .lm-call__date { margin-left: auto; font-size: 11.5px; color: var(--text-3); }
.lm-call__meta { display: flex; align-items: center; gap: 14px; margin-top: 8px; font-size: 12px; color: var(--text-2); flex-wrap: wrap; } .lm-call__meta i { color: var(--text-3); font-size: 11px; } .lm-call__outcome { color: var(--text-3); }
.lm-call__actions { display: flex; gap: 8px; margin-top: 12px; } .lm-transcript { display: flex; flex-direction: column; }
.lm-transcript__row { display: grid; grid-template-columns: 46px 84px 1fr; gap: 10px; padding: 9px 4px; border-bottom: 1px solid var(--border); font-size: 13px; } .lm-transcript__row:last-child { border-bottom: 0; }
.lm-transcript__time { color: var(--text-3); font-variant-numeric: tabular-nums; font-size: 12px; padding-top: 2px; } .lm-transcript__speaker { font-size: 10.5px; font-weight: 700; color: var(--text-1); text-transform: uppercase; letter-spacing: .04em; padding: 3px 8px; border-radius: var(--radius-pill); background: var(--surface-3); text-align: center; align-self: start; } .lm-transcript__speaker.is-agent { color: var(--violet); background: var(--violet-soft); }
.lm-cell { display: flex; flex-direction: column; gap: 3px; min-width: 0; } .lm-cell__main { font-size: 12.5px; font-weight: 600; color: var(--text-1); } .lm-cell__sub { font-size: 11px; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lm-link { background: none; border: none; padding: 0; text-align: left; cursor: pointer; color: var(--primary); font-weight: 700; font-size: 13px; line-height: 1.3; } .lm-link:hover { text-decoration: underline; } .lm-link.is-ref { font-size: 11px; color: var(--text-3); font-weight: 600; letter-spacing: .03em; font-variant-numeric: tabular-nums; } .lm-link.is-ref:hover { color: var(--primary); }
.text-violet { color: var(--violet) !important; } .ds { display: flex; flex-direction: column; gap: 14px; } .ds-fixed { height: 300px; overflow-y: auto; }

/* Dashboard section hierarchy — small uppercase muted headers */
.ds-section { display: flex; flex-direction: column; gap: 8px; }
.ds-section__title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--text-3); margin: 0; display: flex; align-items: center; gap: 8px; line-height: 1; }
.ds-section__title::after { content: ''; flex: 1; height: 1px; background: var(--border); }
.ds .page-header { margin-bottom: 8px; }
.ds .page-header__title { font-size: 28px; font-weight: 700; letter-spacing: -.02em; }
.ds .page-header__subtitle { font-size: 13px; font-weight: 500; margin-top: 4px; }
.ds .card { border-radius: 14px; box-shadow: var(--shadow-xs); transition: box-shadow 150ms ease, border-color 150ms ease; }
.ds .card:hover { box-shadow: var(--shadow-sm); border-color: var(--border-strong); }
.ds .card-header { padding: 12px 16px 8px; border-bottom-color: var(--border); }
.ds .card-body { padding: 12px 16px; }
.ds .card-title { font-size: 18px; font-weight: 700; }
.ds .card-subtitle { font-size: 13px; font-weight: 500; margin-top: 3px; }
.ds .card-title i { font-size: 17px; line-height: 1; }
.ds .e-table thead th { font-size: 13px; font-weight: 600; text-transform: none; letter-spacing: 0; padding: 8px 14px; }
.ds .e-table tbody td { font-size: 14px; font-weight: 500; padding: 8px 14px; }
.ds .badge { font-weight: 600; border-radius: 6px; padding: 3px 8px; font-size: 11.5px; }
.ds .badge.text-bg-success { background: var(--success-soft) !important; color: var(--success) !important; }
.ds .badge.text-bg-secondary { background: var(--surface-2) !important; color: var(--text-2) !important; }
.ds .btn-sm { padding: 5px 10px; border-radius: 8px; }
.ds-fixed::-webkit-scrollbar { width: 6px; height: 6px; }
.ds-fixed::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: var(--radius-pill); }
.ds-fixed::-webkit-scrollbar-track { background: transparent; }
.ds-fixed { scrollbar-width: thin; scrollbar-color: var(--border-strong) transparent; }
.ds-pld__body { position: relative; }
.ds-pld__wrap { position: relative; width: 152px; height: 152px; flex-shrink: 0; } .ds-pld__svg { width: 100%; height: 100%; display: block; }
.ds-pld__track { fill: none; stroke: var(--surface-2); stroke-width: 24; }
.ds-pld__seg-wrap { cursor: pointer; outline: none; transform-box: fill-box; transform-origin: center; transform: translate(0,0) scale(1); transition: transform 200ms ease, filter 200ms ease, opacity 200ms ease; }
.ds-pld__seg-wrap:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; border-radius: 8px; }
.ds-pld__seg { fill: none; stroke-width: 24; stroke-linecap: butt; stroke: var(--seg, var(--primary)); }
.ds-pld__seg-wrap--danger { --seg: var(--danger); } .ds-pld__seg-wrap--warning { --seg: var(--warning); }
.ds-pld__seg-wrap--info { --seg: var(--info); } .ds-pld__seg-wrap--success { --seg: var(--success); }
.ds-pld__seg-wrap.is-hover, .ds-pld__seg-wrap.is-active { transform: translate(calc(var(--dx) * 1px), calc(var(--dy) * 1px)) scale(1.03); filter: drop-shadow(0 6px 14px rgba(17,24,39,.18)); z-index: 2; }
.ds-pld__svg--has-active .ds-pld__seg-wrap:not(.is-active):not(.is-hover) { opacity: .4; }
.ds-pld__center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; pointer-events: none; }
.ds-pld__total { font-size: 21px; font-weight: 700; line-height: 1; color: var(--text-1); font-variant-numeric: tabular-nums; } .ds-pld__label { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-3); white-space: nowrap; }
.ds-pld__tip { position: absolute; z-index: 20; min-width: 124px; padding: 7px 10px; border-radius: 8px; background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow-md); transform: translate(-50%, -50%); pointer-events: none; opacity: 0; transition: opacity 150ms ease; }
.ds-pld__tip.is-visible { opacity: 1; }
.ds-pld__tip-name { display: flex; align-items: center; gap: 6px; font-size: 11.5px; font-weight: 800; color: var(--text-1); } .ds-pld__tip-row { font-size: 11px; color: var(--text-2); margin-top: 2px; font-variant-numeric: tabular-nums; }
.ds-pld__legend { display: flex; flex-direction: column; gap: 2px; } .ds-pld__item { display: grid; grid-template-columns: 10px 1fr auto 40px; align-items: center; column-gap: 9px; width: 100%; padding: 5px 8px; border: 1px solid transparent; border-radius: 8px; background: none; text-align: left; cursor: pointer; transition: background 120ms ease, border-color 120ms ease; } .ds-pld__item:hover { background: var(--surface-2); border-color: var(--border); } .ds-pld__item.is-active { background: var(--primary-soft); border-color: var(--primary-border); }
.ds-pld__dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; } .ds-pld__dot--danger { background: var(--danger); } .ds-pld__dot--warning { background: var(--warning); } .ds-pld__dot--info { background: var(--info); } .ds-pld__dot--success { background: var(--success); } .ds-pld__dot--primary { background: var(--primary); } .ds-pld__name { font-size: 12.5px; font-weight: 700; color: var(--text-1); white-space: nowrap; } .ds-pld__count { font-size: 12.5px; font-weight: 800; color: var(--text-1); font-variant-numeric: tabular-nums; } .ds-pld__pct { font-size: 11px; font-weight: 600; color: var(--text-3); font-variant-numeric: tabular-nums; text-align: right; }
.ds-pld__chip { gap: 10px; padding-left: 10px; } .ds-pld__chip-x { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; padding: 0; border: none; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; font-size: 9px; line-height: 1; transition: background 150ms ease; } .ds-pld__chip-x:hover { background: rgba(65,84,241,.14); }
.ds-readiness { display: flex; flex-direction: column; gap: 2px; } .ds-readiness__row { display: flex; align-items: center; gap: 12px; width: 100%; padding: 5px 10px; border: 1px solid transparent; border-radius: 10px; background: none; text-align: left; cursor: pointer; transition: background 120ms ease, border-color 120ms ease; } .ds-readiness__row:hover { background: var(--surface-2); border-color: var(--border); }
.ds-readiness__icon { width: 28px; height: 28px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; flex-shrink: 0; }
.ds-readiness__icon--success { color: var(--success); background: var(--success-soft); } .ds-readiness__icon--amber, .ds-readiness__icon--warning { color: #b45309; background: var(--warning-soft); }
.ds-readiness__icon--info { color: var(--info); background: var(--info-soft); } .ds-readiness__icon--danger { color: var(--danger); background: var(--danger-soft); }
.ds-readiness__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; } .ds-readiness__label { font-size: 12px; font-weight: 700; color: var(--text-1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.3; }
.ds-readiness__desc { font-size: 10px; font-weight: 600; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.3; } .ds-readiness__count { font-size: 16px; font-weight: 800; color: var(--text-1); font-variant-numeric: tabular-nums; } .ds-readiness__chev { font-size: 12px; color: var(--text-3); flex-shrink: 0; }
.ds-bars { display: flex; flex-direction: column; gap: 12px; } .ds-bar-row { display: flex; flex-direction: column; gap: 5px; padding: 7px 8px; margin: -7px -8px; border-radius: 8px; border: 1px solid transparent; cursor: pointer; transition: background 150ms ease, border-color 150ms ease; } .ds-bar-row:hover { background: var(--surface-2); border-color: var(--border); }
.ds-bar-row:focus-visible { outline: 2px solid var(--primary); outline-offset: 1px; }
.ds-bar-row__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; } .ds-bar-row__name { font-size: 13px; font-weight: 600; color: var(--text-1); } .ds-bar-row__count { font-size: 12.5px; font-weight: 600; color: var(--text-1); font-variant-numeric: tabular-nums; }
.ds-bar-row__track { height: 10px; border-radius: var(--radius-pill); background: var(--surface-3); overflow: hidden; } .ds-bar-row__fill { height: 100%; border-radius: var(--radius-pill); background: var(--primary); transition: width 500ms cubic-bezier(.4,0,.2,1); }
.ds-bar-row__fill--info { background: var(--info); } .ds-bar-row__fill--success { background: var(--success); } .ds-bar-row__fill--violet { background: var(--violet); } .ds-bar-row__fill--warning, .ds-bar-row__fill--amber { background: var(--warning); }
.ds .card-title i { font-size: 16px; line-height: 1; }
.ds-hotq__row { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border); cursor: pointer; transition: border-color 150ms ease, background 150ms ease, box-shadow 150ms ease; } .ds-hotq__row:hover { border-color: var(--primary-border); background: var(--primary-soft); box-shadow: var(--shadow-xs); }
.ds-hotq__row:focus-visible { outline: 2px solid var(--primary); outline-offset: 1px; }
.ds-avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--primary-soft); color: var(--primary); font-size: 11px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; line-height: 1; } .ds-avatar--sm { width: 26px; height: 26px; border-radius: 7px; font-size: 9px; } .ds-avatar--danger { background: var(--danger-soft); color: var(--danger); } .ds-hotq__who { flex: 1; min-width: 0; }
.ds-hotq__name { font-size: 13px; font-weight: 700; color: var(--text-1); } .ds-hotq__meta { display: flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 500; color: var(--text-3); margin-top: 2px; } .ds-hotq__meta i { font-size: 11px; }
.ds-hotq__prio { padding: 2px 8px; border-radius: var(--radius-pill); font-size: 10px; font-weight: 800; white-space: nowrap; border: 1px solid; }
.ds-hotq__prio--danger { color: #c92626; background: var(--danger-soft); border-color: var(--danger-border); } .ds-hotq__prio--warning { color: #b45309; background: var(--warning-soft); border-color: var(--warning-border); } .ds-hotq__prio--primary { color: var(--primary); background: var(--primary-soft); border-color: var(--primary-border); } .ds-hotq__prio--neutral { color: var(--text-2); background: var(--surface-2); border-color: var(--border-strong); }
.ds-hotq__date { font-size: 12px; font-weight: 500; color: var(--text-3); white-space: nowrap; display: inline-flex; align-items: center; gap: 2px; } .ds-hotq__date i { font-size: 12px; } .ds-intakes { display: flex; flex-direction: column; gap: 10px; }
.ds-intake { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 14px; border-radius: 10px; background: var(--surface-2); border: 1px solid var(--border); }
.ds-intake__info { min-width: 0; } .ds-intake__side { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.ds-intake__pct { --intake-fill: 6%; position: relative; width: 64px; height: 6px; border-radius: var(--radius-pill); background: var(--surface-3); overflow: hidden; } .ds-intake__pct::after { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--intake-fill); background: var(--primary); border-radius: inherit; }
.ds-cohort__name { font-size: 12.5px; font-weight: 800; color: var(--text-1); } .ds-cohort__meta { font-size: 11px; color: var(--text-3); margin-top: 2px; }
.ds-pld__body { padding-top: 14px; padding-bottom: 14px; }
@media (max-width: 575.98px) { .ds-pld__body { padding-top: 12px; padding-bottom: 12px; } .ds-pld__wrap { width: 148px; height: 148px; } } @media (max-width: 420px) { .signin-demo-grid { grid-template-columns: 1fr; } }

/* --------------------------------------------------------------------------
   10. KPI STRIP — single bordered enterprise strip, no per-metric cards
   -------------------------------------------------------------------------- */
.kpi-strip { display: flex; flex-wrap: wrap; align-items: stretch; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 20px; column-gap: 32px; row-gap: 6px; }
.kpi-strip__item { display: flex; align-items: center; gap: 12px; flex: 1 1 0; min-width: 150px; padding: 6px 4px; cursor: pointer; border-radius: var(--radius-sm); transition: background var(--transition-fast); }
.kpi-strip__item > i { font-size: 16px; line-height: 1; color: var(--text-3); flex-shrink: 0; }
.kpi-strip__cell { min-width: 0; }
.kpi-strip__num { font-size: 28px; font-weight: 600; line-height: 1; color: var(--text-1); font-variant-numeric: tabular-nums; }
.kpi-strip__label { font-size: 13px; color: var(--text-3); margin-top: 5px; line-height: 1.25; }
.kpi-strip__item:hover { background: var(--surface-2); }
.kpi-strip__live { display: flex; align-items: center; gap: 10px; margin-inline-start: auto; flex-shrink: 0; align-self: center; }
.kpi-strip__live-badge { display: inline-flex; align-items: center; gap: 6px; }
.kpi-strip__live-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.kpi-strip__live-note { font-size: 13px; color: var(--text-3); }
@media (min-width: 768px) { .kpi-strip__item { min-width: 190px; } }
@media (min-width: 992px) { .kpi-strip__item { min-width: 0; } .kpi-strip__item + .kpi-strip__item { border-inline-start: 1px solid var(--border); } }
/* Premium dashboard variant — tinted icon chips, hero numbers, soft shadow */
.kpi-strip--cards { padding: 8px 4px; column-gap: 4px; box-shadow: var(--shadow-xs); border-radius: 14px; }
.kpi-strip--cards .kpi-strip__item { padding: 6px 12px; border-radius: var(--radius); transition: background 150ms ease, box-shadow 150ms ease, transform 150ms ease; }
.kpi-strip--cards .kpi-strip__item:hover { background: var(--surface-2); box-shadow: var(--shadow-xs); }
.kpi-strip--cards .kpi-strip__item + .kpi-strip__item { border-inline-start: 1px solid var(--border); }
.kpi-strip__icon { width: 42px; height: 42px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; font-size: 17px; flex-shrink: 0; }
.kpi-strip__item--primary .kpi-strip__icon { color: var(--primary); background: var(--primary-soft); }
.kpi-strip__item--success .kpi-strip__icon { color: var(--success); background: var(--success-soft); }
.kpi-strip__item--warning .kpi-strip__icon { color: #b45309; background: var(--warning-soft); }
.kpi-strip__item--danger .kpi-strip__icon { color: var(--danger); background: var(--danger-soft); }
.kpi-strip__item--info .kpi-strip__icon { color: var(--info); background: var(--info-soft); }
.kpi-strip__item--violet .kpi-strip__icon { color: var(--violet); background: var(--violet-soft); }
.kpi-strip--cards .kpi-strip__num { font-size: 46px; font-weight: 700; letter-spacing: -.02em; }
.kpi-strip--cards .kpi-strip__label { font-size: 13px; font-weight: 500; }
.kpi-strip--cards .kpi-strip__cell { display: flex; flex-direction: column; justify-content: center; }
.kpi-strip__trend { font-size: 12px; font-weight: 500; color: var(--text-3); margin-top: 3px; line-height: 1.25; }
/* Compact workspace summary strip (~56-64px): label · value inline, single row, scrolls if tight */
.kpi-strip--compact { flex-wrap: nowrap; overflow-x: auto; align-items: center; padding: 8px 14px; column-gap: 4px; row-gap: 0; min-height: 56px; scrollbar-width: thin; }
.kpi-strip--compact .kpi-strip__item { flex: 1 1 0; min-width: 0; padding: 3px 12px; gap: 8px; }
.kpi-strip--compact .kpi-strip__item > i { font-size: 13px; }
.kpi-strip--compact .kpi-strip__cell { display: inline-flex; align-items: baseline; gap: 6px; }
.kpi-strip--compact .kpi-strip__num { font-size: 15px; font-weight: 700; }
.kpi-strip--compact .kpi-strip__label { font-size: 11.5px; margin-top: 0; white-space: nowrap; font-weight: 500; }
.kpi-strip--compact .kpi-strip__live { gap: 8px; margin-inline-start: auto; }
.kpi-strip--compact .kpi-strip__live-note { font-size: 12px; white-space: nowrap; }

/* --------------------------------------------------------------------------
   11. WORKSPACE MODAL — record workspace (Lead / User profiles)
   Left-aligned inside the app shell content area. Sidebar + header stay
   visible underneath the overlay. Fixed header/footer; only body scrolls.
   Desktop ~80% content width (cap 1100px) / ~82vh, tablet 90%, mobile full.
   -------------------------------------------------------------------------- */
.workspace-modal .modal-dialog {
  position: absolute;
  margin: 0;
  top: calc(var(--sh-header-h) + 16px);
  bottom: calc(var(--sh-footer-h) + 16px);
  left: calc(var(--sh-sidebar-w) + 16px);
  width: calc((100vw - var(--sh-sidebar-w) - 16px) * 0.8);
  max-width: 1100px;
  transform: none;
}
.sh-shell--collapsed .workspace-modal .modal-dialog {
  left: calc(var(--sh-sidebar-c) + 16px);
  width: calc((100vw - var(--sh-sidebar-c) - 16px) * 0.8);
}
.workspace-modal .modal-content { border-radius: 12px; overflow: hidden; }
.workspace-modal .modal-dialog-scrollable .modal-content { max-height: 100%; }
.workspace-header { padding: 14px 18px; }
.workspace-modal .modal-body { padding: 16px 18px; }
.workspace-modal .modal-footer { padding: 10px 18px; }
@media (max-width: 991.98px) {
  .workspace-modal .modal-dialog { width: calc((100vw - var(--sh-sidebar-w) - 16px) * 0.9); }
  .sh-shell--collapsed .workspace-modal .modal-dialog { width: calc((100vw - var(--sh-sidebar-c) - 16px) * 0.9); }
}
@media (max-width: 575.98px) {
  .workspace-modal .modal-dialog { inset: 0; width: 100vw; max-width: none; }
  .workspace-modal .modal-content { border-radius: 0; }
}

/* --------------------------------------------------------------------------
   11b. LEAD WORKSPACE MODAL — scoped compact premium profile redesign.
   Every rule here is scoped to `.workspace-modal--lead` (the lead profile
   workspace opened from the Leads table) so the base `.workspace-modal`
   rules used by Import Leads / User Management modals stay untouched.
   Header + footer are stable bars; only `.modal-body` scrolls.
   -------------------------------------------------------------------------- */

/* ── Shell: compact FLOATING DIALOG, centered in the viewport. Never
      pinned to the shell edges — `inset: 0` + `margin: auto` centers it
      horizontally AND vertically, so visible backdrop space surrounds all
      four sides. Height hugs content (auto) and is hard-capped so the box
      can never grow to fill the viewport; only `.modal-body` scrolls. ── */
.workspace-modal--lead .modal-dialog {
  position: absolute;
  inset: 0;
  margin: auto;
  width: min(960px, calc(100vw - 48px));
  max-width: min(960px, calc(100vw - 48px));
  height: auto;
  max-height: min(720px, calc(100vh - 48px));
  transform: none;
}
.workspace-modal--lead .modal-content { border-color: var(--border-strong); border-radius: 14px; box-shadow: var(--shadow-lg); }
.workspace-modal--lead .modal-header { padding: 10px 16px; align-items: flex-start; gap: 8px; border-bottom: 1px solid var(--border); }
.workspace-modal--lead .modal-body { padding: 8px 16px 10px; }
.workspace-modal--lead .modal-footer { padding: 8px 16px; gap: 6px; border-top: 1px solid var(--border); background: var(--surface-2); flex-shrink: 0; }

/* ── Compact lead identity header ──────────────────────────────────── */
.workspace-modal--lead .lm-modal-title { font-size: 16px; font-weight: 700; letter-spacing: -.01em; color: var(--text-1); line-height: 1.2; }
.workspace-modal--lead .lm-modal-sub { display: flex; align-items: center; gap: 6px; margin-top: 1px; font-size: 11.5px; color: var(--text-3); font-variant-numeric: tabular-nums; }
.workspace-modal--lead .lm-modal-sub i { font-size: 10.5px; color: var(--text-3); }

/* ── Body: single scrolling column of compact sections ─────────────── */
.workspace-modal--lead .lm-modal-body { display: flex; flex-direction: column; gap: 10px; }
.workspace-modal--lead .aw-section { gap: 6px; }
.workspace-modal--lead .aw-section__label { padding-bottom: 4px; }

/* ── Lead Pipeline: tight stepper + compact action row ─────────────── */
.workspace-modal--lead .lead-stages { margin-top: 4px; }
.workspace-modal--lead .lead-stage { gap: 3px; }
.workspace-modal--lead .lead-stage::before { top: 6px; }
.workspace-modal--lead .lead-stage__dot { width: 14px; height: 14px; font-size: 7px; }
.workspace-modal--lead .lead-stage__label { font-size: 9.5px; line-height: 1.2; }
.workspace-modal--lead .lm-pipeline-action { margin-top: 6px; padding-top: 6px; border-top: 1px dashed var(--border); display: flex; justify-content: flex-end; }
.workspace-modal--lead .lm-pipeline-action .btn { display: inline-flex; align-items: center; gap: 4px; height: 30px; padding: 0 12px; font-size: 12px; font-weight: 600; border-radius: var(--radius-sm); }

/* ── Personal Information: dense label/value grid ──────────────────── */
.workspace-modal--lead .lm-info-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 16px; row-gap: 6px; }
.workspace-modal--lead .lm-info-cell { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.workspace-modal--lead .lm-info-cell__label { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.workspace-modal--lead .lm-info-cell__value { font-size: 12px; font-weight: 600; color: var(--text-1); line-height: 1.35; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
@media (max-width: 991.98px) { .workspace-modal--lead .lm-info-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 767.98px) { .workspace-modal--lead .lm-info-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

/* ── Lead Timeline: very compact vertical stream ───────────────────── */
.workspace-modal--lead .timeline { padding-left: 20px; }
.workspace-modal--lead .timeline::before { left: 6px; top: 4px; bottom: 4px; }
.workspace-modal--lead .timeline__item { padding: 0 0 6px; }
.workspace-modal--lead .timeline__item:last-child { padding-bottom: 0; }
.workspace-modal--lead .timeline__dot { left: -20px; top: 1px; width: 12px; height: 12px; font-size: 5.5px; border-width: 1.5px; }
.workspace-modal--lead .timeline__title { font-size: 12px; font-weight: 600; line-height: 1.3; }
.workspace-modal--lead .timeline__detail { font-size: 11.5px; line-height: 1.35; margin-top: 0; }
.workspace-modal--lead .timeline__time { font-size: 10px; margin-top: 1px; }

/* ── Counsellor Remarks: tight notes + matched input/Add row ───────── */
.workspace-modal--lead .lead-note { padding: 6px 9px; margin-bottom: 4px; }
.workspace-modal--lead .lead-note__text { font-size: 12px; line-height: 1.4; }
.workspace-modal--lead .lead-note__meta { margin-top: 2px; font-size: 10px; }
.workspace-modal--lead .lm-remark-form { display: flex; align-items: center; gap: 6px; margin-top: 6px; }
.workspace-modal--lead .lm-remark-form .form-control { flex: 1 1 auto; min-width: 0; }
.workspace-modal--lead .lm-remark-form .btn { flex-shrink: 0; display: inline-flex; align-items: center; height: 31px; padding: 0 12px; font-size: 12px; font-weight: 600; border-radius: var(--radius-sm); white-space: nowrap; }

/* ── Call History: compact cards ───────────────────────────────────── */
.workspace-modal--lead .lm-call { padding: 8px 10px; margin-bottom: 6px; }
.workspace-modal--lead .lm-call__head { gap: 6px; }
.workspace-modal--lead .lm-call__num { font-size: 12px; }
.workspace-modal--lead .lm-call__date { font-size: 11px; }
.workspace-modal--lead .lm-call__meta { margin-top: 4px; gap: 10px; font-size: 11.5px; }

/* ── Customer Details / Follow-up: tight KV rows ───────────────────── */
.workspace-modal--lead .lm-kv-grid { column-gap: 16px; }
.workspace-modal--lead .aw-kv { padding: 2px 0; font-size: 12px; }
.workspace-modal--lead .lead-agent-box { gap: 8px; }
.workspace-modal--lead .lead-agent-box__initials { width: 30px; height: 30px; font-size: 12px; }
.workspace-modal--lead .lead-agent-box__name { font-size: 12.5px; }
.workspace-modal--lead .lead-agent-box__meta { font-size: 11px; }

/* ── Footer: uniform compact actions over a stable bar ─────────────── */
.workspace-modal--lead .modal-footer .btn { display: inline-flex; align-items: center; height: 34px; padding: 0 12px; font-size: 12px; font-weight: 600; border-radius: var(--radius-sm); }
.workspace-modal--lead .modal-footer .btn i { font-size: 11px; }

/* --------------------------------------------------------------------------
   11c. USER-DETAILS WORKSPACE MODAL — scoped compact premium profile redesign.
   Mirrors the `.workspace-modal--lead` pattern: a centered FLOATING dialog
   with a content-driven height (hard-capped), stable header + footer, and
   only `.modal-body` scrolls. Every rule is scoped to
   `.workspace-modal--user-details` so the base workspace modal (used by
   Import Leads) and the lead modal stay untouched.
   -------------------------------------------------------------------------- */

/* ── Shell: compact centered floating dialog, never full-screen ── */
.workspace-modal--user-details .modal-dialog {
  position: absolute;
  inset: 0;
  margin: auto;
  width: min(880px, calc(100vw - 48px));
  max-width: min(880px, calc(100vw - 48px));
  height: auto;
  max-height: min(680px, calc(100vh - 48px));
  transform: none;
}
.workspace-modal--user-details .modal-content { border-color: var(--border-strong); border-radius: 14px; box-shadow: var(--shadow-xl); }
.workspace-modal--user-details .modal-header { padding: 12px 18px; gap: 10px; border-bottom: 1px solid var(--border); align-items: center; }
.workspace-modal--user-details .modal-body { padding: 14px 18px 16px; }
.workspace-modal--user-details .modal-footer { padding: 10px 18px; gap: 8px; border-top: 1px solid var(--border); background: var(--surface-2); flex-shrink: 0; }

/* ── Compact profile identity header ─────────────────────────────── */
.workspace-modal--user-details .um-profile-head { display: flex; align-items: center; gap: 12px; min-width: 0; }
.workspace-modal--user-details .um-profile-head__avatar { width: 44px; height: 44px; font-size: 16px; box-shadow: 0 0 0 1px var(--border); }
.workspace-modal--user-details .um-profile-head__body { min-width: 0; }
.workspace-modal--user-details .um-profile-head__row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.workspace-modal--user-details .um-profile-head__name { font-size: 16px; font-weight: 700; letter-spacing: -.01em; color: var(--text-1); line-height: 1.25; }
.workspace-modal--user-details .um-profile-head__email { margin-top: 2px; font-size: 12px; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ── Soft semantic badges / chips ────────────────────────────────── */
.workspace-modal--user-details .um-badge {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 2px 9px; border-radius: var(--radius-pill);
  font-size: 11px; font-weight: 600; line-height: 1.5; white-space: nowrap;
}
.workspace-modal--user-details .um-badge__dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.workspace-modal--user-details .um-badge--primary { background: var(--primary-soft); color: var(--primary); }
.workspace-modal--user-details .um-badge--violet { background: var(--violet-soft); color: var(--violet); }
.workspace-modal--user-details .um-badge--success { background: var(--success-soft); color: var(--success); }
.workspace-modal--user-details .um-badge--danger { background: var(--danger-soft); color: var(--danger); }
.workspace-modal--user-details .um-badge--neutral { background: var(--surface-2); color: var(--text-2); border: 1px solid var(--border); }
.workspace-modal--user-details .um-chip {
  display: inline-flex; align-items: center;
  padding: 3px 10px; border-radius: var(--radius-pill);
  font-size: 11.5px; font-weight: 500; color: var(--text-2);
  background: var(--surface-2); border: 1px solid var(--border);
}

/* ── Premium tab bar (restyles the shared Tabs nav-pills, scoped) ── */
.workspace-modal--user-details .um-tabs { border-bottom: 1px solid var(--border); }
.workspace-modal--user-details .um-tabs .btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 12px; font-size: 12.5px; font-weight: 600; line-height: 1.4;
  border: 0; border-radius: 8px 8px 0 0; box-shadow: none;
  color: var(--text-3); background: transparent; position: relative;
}
.workspace-modal--user-details .um-tabs .btn:hover { color: var(--text-1); background: var(--surface-3); }
.workspace-modal--user-details .um-tabs .btn[aria-selected='true'] { color: var(--primary); background: var(--primary-soft); }
.workspace-modal--user-details .um-tabs .btn[aria-selected='true']::after {
  content: ''; position: absolute; left: 10px; right: 10px; bottom: 0; height: 2px;
  border-radius: 2px 2px 0 0; background: var(--primary);
}
.workspace-modal--user-details .um-tabs .btn i { font-size: 12px; }

/* ── Overview: compact label/value grid ──────────────────────────── */
.workspace-modal--user-details .um-overview-card { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); padding: 14px 16px; }
.workspace-modal--user-details .um-info-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 20px; row-gap: 14px; }
.workspace-modal--user-details .um-info-cell { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.workspace-modal--user-details .um-info-cell__label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.workspace-modal--user-details .um-info-cell__value { font-size: 13px; font-weight: 600; color: var(--text-1); line-height: 1.35; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
@media (max-width: 991.98px) { .workspace-modal--user-details .um-info-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 575.98px) { .workspace-modal--user-details .um-info-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); } }

/* ── Login history: tight cards reusing the info-cell styling ────── */
.workspace-modal--user-details .um-login-card { border: 1px solid var(--border); border-radius: var(--radius); padding: 12px 14px; }

/* ── Footer: uniform compact actions ─────────────────────────────── */
.workspace-modal--user-details .modal-footer .btn {
  display: inline-flex; align-items: center; gap: 6px;
  height: 34px; padding: 0 14px; font-size: 12px; font-weight: 600;
  border-radius: var(--radius-sm); white-space: nowrap;
}
.workspace-modal--user-details .modal-footer .btn i { font-size: 12px; }
.workspace-modal--user-details .modal-footer .btn-outline-secondary { color: var(--text-2); border-color: var(--border-strong); }
.workspace-modal--user-details .modal-footer .btn-outline-secondary:hover { background: var(--surface-3); color: var(--text-1); border-color: var(--border-strong); }
.workspace-modal--user-details .modal-footer .btn-outline-danger { color: var(--danger); border-color: var(--danger-border); }
.workspace-modal--user-details .modal-footer .btn-outline-danger:hover { background: var(--danger-soft); color: var(--danger); border-color: var(--danger-border); }
.workspace-modal--user-details .modal-footer .btn-primary { color: #fff; background: var(--primary); border-color: var(--primary); box-shadow: 0 2px 6px rgba(65, 84, 241, .28); }

/* --------------------------------------------------------------------------
   12. INTERNAL TABLE SCROLL — table pages (User / Lead) pin toolbar, sticky
   header and pagination; only the table body scrolls vertically inside the
   shell content area. No custom scrollbar JS.
   -------------------------------------------------------------------------- */
.table-page {
  height: 100%;
  display: flex;
  flex-direction: column;
}
.table-page > :not(.e-table-wrap) { flex-shrink: 0; }
.table-page .e-table-wrap {
  flex: 1;
  min-height: 260px;
  display: flex;
  flex-direction: column;
}
.table-page .e-table-wrap > :not(.e-table-scroll) { flex-shrink: 0; }
.table-page .e-table-scroll {
  flex: 1;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
}

/* 12b. REPORTS — the page wrapper keeps the pinned layout. The MUI card, tabs,
   toolbar and table (src/ui/mui/DataTable) manage their own layout and internal
   scrolling via muiTheme.js — see components/Reports.jsx. */
.report-page {
  height: 100%;
  display: flex;
  flex-direction: column;
}
.report-page > .page-header { flex-shrink: 0; }

/* --------------------------------------------------------------------------
   13. USER DIRECTORY — compact fixed-layout table that fits the content area.
   Column widths are % of the available main-content width (never 100vw).
   Hideable columns are removed via the cell classes below so remaining
   columns redistribute to fill the table without horizontal scrolling.
   -------------------------------------------------------------------------- */
.ud-table { table-layout: fixed; width: 100%; max-width: 100%; box-sizing: border-box; }
.ud-table thead th { overflow: hidden; text-overflow: ellipsis; font-size: 13px; font-weight: 600; color: #6B7280; }
.ud-table tbody td { padding: 8px 14px; height: 56px; font-size: 14px; font-weight: 500; }
/* Lock row heights: content cells clip instead of growing the row */
.ud-table tbody td:not(.ud-actions) { overflow: hidden; }
.ud-user { min-width: 0; line-height: 1.35; }
.ud-user .user-link { font-size: 15px; font-weight: 600; }
.ud-email { margin-top: 2px; font-size: 13px; font-weight: 400; color: #6B7280; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ud-tq { display: flex; flex-direction: column; gap: 2px; min-width: 0; line-height: 1.35; }
.ud-tq__team { font-size: 14px; font-weight: 500; color: var(--text-1); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ud-tq__team.is-unassigned { font-weight: 500; color: var(--text-3); }
.ud-tq__queue { font-size: 13px; font-weight: 400; color: var(--text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ud-status, .ud-actions { white-space: nowrap; }
.ud-status { font-size: 13px; font-weight: 400; color: var(--text-1); }
/* Role badges — lead-management style pill, restrained semantic tones */
.ud-role-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  height: 22px;
  padding: 0 8px;
  font-size: 12px;
  font-weight: 500;
  line-height: 1;
  border-radius: 999px;
  white-space: nowrap;
}
.ud-role-badge::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; opacity: 0.75; }
.ud-role-badge--supervisor { color: var(--violet); background: var(--violet-soft); }
.ud-role-badge--agent { color: var(--primary); background: var(--primary-soft); }
.ud-role-badge--other { color: var(--text-3); background: var(--surface-2); }
/* Actions — comfortable 34px hit area */
.ud-actions .icon-btn { width: 34px; height: 34px; }
/* Numeric cells — aligned, scannable */
.ud-table .cell-num { font-size: 14px; }
.ud-table .cell-muted { font-size: 13px; }
[data-theme='dark'] .ud-table thead th,
[data-theme='dark'] .ud-email { color: var(--text-3); }
/* Checkbox column polish */
.ud-table .e-table-check { width: 44px; }
.ud-table .form-check-input { width: 16px; height: 16px; margin: 0; cursor: pointer; }

/* ---- User Management KPI cards ---- */
.um-kpi { padding: 0; border: 0; background: transparent; box-shadow: none; gap: 12px; }
.um-kpi .kpi-strip__item {
  flex: 1 1 0;
  min-width: 150px;
  padding: 14px 16px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: var(--shadow-xs);
  cursor: default;
}
.um-kpi .kpi-strip__item:hover { background: var(--surface); box-shadow: var(--shadow-sm); }
.um-kpi .kpi-strip__icon { width: 40px; height: 40px; border-radius: 10px; font-size: 16px; }
.um-kpi .kpi-strip__num { font-size: 28px; font-weight: 700; letter-spacing: -0.02em; }
.um-kpi .kpi-strip__label { font-size: 12.5px; font-weight: 500; margin-top: 4px; }

/* ---- User Management directory toolbar ---- */
.ud-toolbar-sub { font-size: 12px; color: var(--text-3); }
.ud-filters { gap: 8px; display: flex; align-items: center; flex-wrap: nowrap; }
.ud-search { position: relative; flex: 1 1 320px; min-width: 200px; max-width: 520px; }
.ud-search > i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 14px; color: var(--text-3); pointer-events: none; }
.ud-filters .form-control,
.ud-filters .form-select {
  height: 36px;
  font-size: 14px;
  border-radius: 8px;
  border-color: var(--border);
  padding: 0 10px;
  line-height: 34px;
}
.ud-filters .form-select { padding-right: 30px; }
.ud-filters .ud-search-input { width: 100%; height: 36px; padding: 0 12px 0 34px; }
.ud-filters .ud-search-input::placeholder { font-size: 14px; color: var(--text-3); }
.ud-filter-select { flex: 0 1 132px; min-width: 96px; }
.ud-export-btn {
  --bs-btn-color: #111827;
  --bs-btn-hover-color: #111827;
  --bs-btn-hover-bg: var(--surface-2);
  --bs-btn-hover-border-color: var(--border-strong);
  --bs-btn-active-color: #111827;
  --bs-btn-active-bg: var(--surface-3);
  --bs-btn-active-border-color: var(--border-strong);
  height: 36px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 12px;
  font-size: 14px;
  font-weight: 500;
  border-radius: 8px;
  flex: 0 0 auto;
}
.ud-table .ud-empty { font-size: 13px; }
/* Tablet: drop CALLS first, then LAST LOGIN on smaller screens — desktop keeps all */
@media (max-width: 1199.98px) { .ud-hide-calls { display: none; } }
@media (max-width: 767.98px) { .ud-hide-login { display: none; } }
/* Mobile: switch to a card layout */
@media (max-width: 767.98px) {
  .ud-filters { flex-wrap: wrap; }
  .ud-search { flex: 1 1 100%; }
  .ud-search-input { width: 100%; }
}
@media (max-width: 575.98px) {
  .table-page .e-table-wrap { min-height: 0; }
  .table-page .ud-table, .table-page .ud-table tbody, .table-page .ud-table tr { display: block; width: 100%; }
  .table-page .ud-table thead { display: none; }
  .table-page .ud-table tr { border: 1px solid var(--border); border-radius: 10px; background: var(--surface); padding: 6px 12px; margin-bottom: 10px; }
  .table-page .ud-table td { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 7px 2px; border: 0; height: auto; }
  .table-page .ud-table td::before { content: attr(data-label); flex-shrink: 0; font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--text-3); }
  .table-page .ud-table .ud-empty { justify-content: center; border: 0; padding: 10px 0; }
  .table-page .ud-table .ud-user { align-items: flex-start; }
  .ud-filters { width: 100%; flex-wrap: wrap; }
  .ud-search { flex: 1 1 100%; }
  .ud-search-input { width: 100%; }
  .ud-filter-select { flex: 1 1 40%; min-width: 0; }
}

/* --------------------------------------------------------------------------
   14. LEAD MANAGEMENT — enterprise workspace layout (compact density)
   -------------------------------------------------------------------------- */
.e-table--lead thead th { font-size: 13px; font-weight: 600; color: #6B7280; }
.e-table--lead tbody td { height: 54px; padding: 7px 14px; overflow: hidden; font-size: 14px; font-weight: 500; }
.e-table--lead .lm-cell { gap: 2px; line-height: 1.35; }
.e-table--lead .lm-cell__main { font-size: 14px; font-weight: 500; }
.e-table--lead .lm-cell__sub { font-size: 13px; font-weight: 400; color: #6B7280; }
.e-table--lead .lm-cell--source .lm-cell__main { font-weight: 600; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.e-table--lead .lm-cell--source .lm-cell__sub { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
.lm-link.is-name { font-size: 15px; font-weight: 600; }
.e-table--lead .badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 22px;
  padding: 0 8px;
  font-size: 12px;
  font-weight: 500;
  line-height: 1;
  border-radius: 999px;
}
[data-theme='dark'] .lm-toolbar-select__label,
[data-theme='dark'] .lm-toolbar-datewrap__label,
[data-theme='dark'] .e-table--lead thead th,
[data-theme='dark'] .e-table--lead .lm-cell__sub { color: var(--text-3); }

/* Lead toolbar — page-level command bars, OUTSIDE the table card. Row 1 is
   a global search (left) + actions (right); row 2 is the filter bar. All
   controls are lightweight command-bar controls: 34px tall (search 36px),
   8px radius, 14px text, thin 1px #E5E7EB border, 8px gaps, single row. */
.lm-command-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  margin: 0 0 10px;
  padding: 6px 16px;
  background: #fff;
  border: 1px solid #E5E7EB;
  border-radius: 12px;
}
.lm-page-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8px;
}
.lm-page-actions .btn {
  height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 0 14px;
  font-size: 14px;
  font-weight: 500;
  line-height: 1;
  border-radius: 8px;
  white-space: nowrap;
}
.lm-page-actions .btn i { font-size: 15px; line-height: 1; }
.lm-page-actions .btn-primary {
  --bs-btn-box-shadow: 0 1px 2px rgba(15, 23, 42, 0.12);
  --bs-btn-hover-box-shadow: 0 3px 8px rgba(65, 84, 241, 0.28);
  --bs-btn-active-box-shadow: inset 0 2px 4px rgba(15, 23, 42, 0.2);
}
.lm-btn--secondary {
  --bs-btn-bg: #ffffff;
  --bs-btn-border-color: var(--border);
  --bs-btn-hover-bg: var(--surface-2);
  --bs-btn-hover-border-color: var(--border-strong);
  --bs-btn-active-bg: var(--surface-3);
  --bs-btn-active-border-color: var(--border-strong);
  --bs-btn-color: #111827;
  --bs-btn-hover-color: #111827;
  --bs-btn-active-color: #111827;
  --bs-btn-disabled-color: var(--text-3);
  --bs-btn-disabled-bg: #ffffff;
  --bs-btn-disabled-border-color: var(--border);
}
.lm-btn--tertiary {
  --bs-btn-bg: transparent;
  --bs-btn-border-color: transparent;
  --bs-btn-hover-bg: var(--surface-2);
  --bs-btn-hover-border-color: transparent;
  --bs-btn-active-bg: var(--surface-3);
  --bs-btn-active-border-color: transparent;
  --bs-btn-color: var(--text-2);
  --bs-btn-hover-color: var(--text-1);
  --bs-btn-active-color: var(--text-1);
  --bs-btn-disabled-color: var(--text-3);
  --bs-btn-disabled-bg: transparent;
  --bs-btn-disabled-border-color: transparent;
}
.lm-toolbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 48px;
  margin: 0 0 12px;
  padding: 5px 16px;
  background: #fff;
  border: 1px solid #E5E7EB;
  border-radius: 12px;
  overflow-x: auto;
}
.lm-toolbar > * { flex: 0 0 auto; }
.lm-toolbar .form-control,
.lm-toolbar .form-select {
  height: 34px;
  font-size: 14px;
  border-radius: 8px;
  border-color: #E5E7EB;
  padding: 0 10px;
  line-height: 32px;
}
.lm-toolbar .form-select { padding-right: 30px; }
.lm-toolbar-search { position: relative; flex: 0 1 480px; min-width: 420px; }
.lm-toolbar-search > i {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 14px;
  color: var(--text-3);
  pointer-events: none;
}
.lm-toolbar-search .form-control { height: 36px; padding-right: 12px; }
.lm-toolbar-search .form-control::placeholder { font-size: 14px; color: var(--text-3); }
/* Native select with a label overlay: closed/"all" state reads as the field
   name ("Disposition"); the "All …" option only appears in the native menu. */
.lm-toolbar-select { position: relative; }
.lm-toolbar-select select { width: 100%; }
.lm-toolbar-select__label {
  position: absolute;
  left: 10px;
  right: 30px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  font-size: 12px;
  font-weight: 500;
  color: #6B7280;
  background: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  pointer-events: none;
}
.lm-toolbar-select.is-set .lm-toolbar-select__label { display: none; }
/* Native date input with a label overlay: empty state reads as "📅 From";
   the native dd-mm-yyyy placeholder only shows once a date is chosen. */
.lm-toolbar-datewrap { position: relative; display: inline-flex; }
.lm-toolbar-datewrap__label {
  position: absolute;
  left: 10px;
  right: 34px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 500;
  color: #6B7280;
  background: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  pointer-events: none;
}
.lm-toolbar-datewrap__label i { font-size: 13px; }
.lm-toolbar-datewrap.is-set .lm-toolbar-datewrap__label { display: none; }
.lm-toolbar-date {
  width: 152px;
  padding-right: 24px;
  min-width: 0;
}
.lm-toolbar-reset {
  height: 34px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0 10px;
  font-size: 14px;
  font-weight: 500;
  color: var(--text-2);
  background: transparent;
  border: 1px solid transparent;
  border-radius: 8px;
  transition: background var(--transition-fast), color var(--transition-fast);
}
.lm-toolbar-reset:hover { background: var(--surface-2); color: var(--text-1); }
.lm-toolbar-reset:active { background: var(--surface-3); }
@media (max-width: 575.98px) {
  .lm-page-actions { justify-content: flex-start; }
  .lm-command-bar { gap: 10px; }
  .lm-toolbar-search { flex: 1 1 100%; min-width: 100%; }
  .lm-toolbar { margin: 0 0 10px; }
  .lm-toolbar-date { width: 142px; padding-right: 20px; }
}

/* --------------------------------------------------------------------------
   15. AGENT WORKSPACE — CTI calling workspace (Aura-style)
   -------------------------------------------------------------------------- */
.aw-root { flex: 1; min-height: 0; padding: 12px; display: flex; flex-direction: column; gap: 10px; overflow: hidden; }

/* ── Call status / KPI strip ───────────────────────────────────── */
.aw-strip { flex-shrink: 0; display: flex; align-items: center; gap: 10px; height: 48px; padding: 0 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--shadow-xs); }
.aw-strip__status { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.aw-status-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; font-weight: 600; color: var(--text-1); background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-pill); padding: 3px 10px; white-space: nowrap; }
.aw-status-pill__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-3); flex-shrink: 0; }
.aw-status-pill.is-ok { color: var(--success); background: var(--success-soft); border-color: var(--success-border); }
.aw-status-pill.is-ok .aw-status-pill__dot { background: var(--success); }
.aw-status-pill.is-warn { color: var(--warning); background: var(--warning-soft); border-color: var(--warning-border); }
.aw-status-pill.is-warn .aw-status-pill__dot { background: var(--warning); }
.aw-status-pill.is-call { color: var(--danger); border-color: var(--danger-border); background: var(--danger-soft); }
.aw-status-pill.is-call .aw-status-pill__dot { background: var(--danger); }
.aw-strip__stats { flex: 1; min-width: 0; display: flex; align-items: stretch; justify-content: center; }
.aw-stat { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; padding: 2px 8px; border-left: 1px solid var(--border); min-width: 0; }
.aw-stat__value { display: inline-flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 700; color: var(--text-1); line-height: 1.15; font-variant-numeric: tabular-nums; }
.aw-stat__value i { width: 18px; height: 18px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; color: var(--primary); background: var(--primary-soft); flex-shrink: 0; }
.aw-stat__label { font-size: 8px; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: .07em; white-space: nowrap; }
.aw-strip__actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

/* ═══════════════════════════════════════════════════════════════════
   ENTERPRISE ACTION BUTTONS — one design language for every dashboard
   action. Filled primary > filled danger (contextual) > filled success
   (submit) > outline (secondary) > ghost (tertiary). 42px height, 11px
   radius, 8px icon gap, 600 weight, 180ms hover with a 1px lift. Every
   button on the dashboard belongs to one of these variants.
   ═══════════════════════════════════════════════════════════════════ */
.aw-btn {
  height: 42px;
  min-width: 160px;
  padding: 0 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid transparent;
  border-radius: 11px;
  font-family: var(--font);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .01em;
  color: #fff;
  background: var(--primary);
  cursor: pointer;
  white-space: nowrap;
  user-select: none;
  transition: background-color .18s ease, border-color .18s ease, color .18s ease, box-shadow .18s ease, transform .18s ease;
}
.aw-btn:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
.aw-btn:hover:not(:disabled):not(.aw-btn--ghost) { transform: translateY(-1px); }
.aw-btn:active:not(:disabled) { transform: translateY(1px); }
.aw-btn:disabled { opacity: .5; cursor: not-allowed; box-shadow: none; }
.aw-btn i { font-size: 14px; }

/* Filled primary — solid brand (the single attention-grabbing action) */
.aw-btn--primary { background: var(--primary); box-shadow: 0 6px 16px rgba(65, 84, 241, .28); }
.aw-btn--primary:hover:not(:disabled) { background: var(--primary-hover); box-shadow: 0 8px 20px rgba(65, 84, 241, .32); }

/* Filled danger — End Call (contextual, while a call is live) */
.aw-btn--danger { background: var(--danger); box-shadow: 0 6px 16px rgba(255, 77, 77, .24); }
.aw-btn--danger:hover:not(:disabled) { background: #e64040; box-shadow: 0 8px 20px rgba(255, 77, 77, .30); }

/* Filled success — Submit Disposition (goal action, once valid) */
.aw-btn--success { background: var(--success); box-shadow: 0 6px 16px rgba(46, 202, 106, .28); }
.aw-btn--success:hover:not(:disabled) { background: #25b45b; box-shadow: 0 8px 20px rgba(46, 202, 106, .32); }

/* Secondary — white/light fill, thin border, primary text. Same height,
   radius and hover lift as primary; only the fill separates them. */
.aw-btn--outline { background: var(--surface); border-color: var(--border-strong); color: var(--text-1); box-shadow: none; }
.aw-btn--outline:hover:not(:disabled) { background: var(--primary-soft); border-color: var(--primary-border); color: var(--primary); }
.aw-btn--outline:disabled { opacity: .45; }

/* Tertiary — ghost / text */
.aw-btn--ghost { min-width: 0; padding: 0 12px; background: transparent; border-color: transparent; color: var(--text-2); box-shadow: none; }
.aw-btn--ghost:hover:not(:disabled) { background: var(--surface-2); color: var(--text-1); }
.aw-btn--ghost:disabled { opacity: .45; }

/* Natural-width standard button — drops the 160px min-width for compact
   spots (card CTAs, top strip) while keeping full height + padding. */
.aw-btn--auto { min-width: 0; padding: 0 20px; }

/* Large variant — the hero CTA (Next Best Action card's primary action).
   44px, 12px radius and roomier padding so it reads as the focal point of
   the dashboard while staying inside the 40–44px button family. */
.aw-btn--lg { height: 44px; min-width: 0; padding: 0 28px; border-radius: 12px; font-size: 14px; }
.aw-btn--lg i { font-size: 15px; }

/* Small variant — compact controls (dense rows, drawers, modals) */
.aw-btn--sm { height: 32px; min-width: 0; padding: 0 12px; border-radius: 10px; font-size: 12.5px; gap: 8px; }
.aw-btn--sm i { font-size: 13px; }

/* Clickable queue KPI — a button that opens its work-queue drawer */
.aw-stat--kpi {
  border: 0;
  background: transparent;
  cursor: pointer;
  font: inherit;
  transition: background-color .15s ease, color .15s ease;
  color: var(--primary);
  border-left: 1px solid var(--border);
}
.aw-stat--kpi:hover { background: var(--primary-soft); color: var(--primary); }
.aw-stat--kpi:hover .aw-stat__label { color: var(--primary); }
.aw-stat--kpi:focus-visible { outline: 2px solid var(--primary); outline-offset: -2px; }

/* ── Fixed three-column desk (Call Dock | Profile | Activity) ── */
.aw-main { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(360px, 360px) minmax(580px, 60fr) minmax(300px, 24fr); gap: 8px; align-items: stretch; }
.aw-col { min-width: 0; min-height: 0; display: flex; flex-direction: column; }

/* Disposition form — body scrolls, submit footer stays pinned */
.aw-disp { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.aw-disp__body { flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 0 0 4px; }
.aw-disp__foot { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 16px; padding: 14px 0 16px; border-top: 1px solid var(--border); }

/* Adaptive disposition form — smooth field appearance + compact spacing */
@keyframes aw-fade-in {
  from { opacity: 0; transform: translateY(-3px); }
  to   { opacity: 1; transform: none; }
}
.aw-anim { animation: aw-fade-in .18s ease both; }
.aw-disp .mb-3 { margin-bottom: .5rem; }
.aw-disp .form-label { margin-bottom: 3px; }
.aw-form-divider { margin: 8px 0 10px; border: 0; border-top: 1px solid var(--border); opacity: 1; }

/* Collapsible optional sections (Reference Details / Remarks) */
.aw-collapse { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--surface); }
.aw-collapse__toggle { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px; background: var(--surface-2); border: 0; cursor: pointer; text-align: left; font-size: 12.5px; font-weight: 600; color: var(--text-1); transition: background var(--transition-fast); }
.aw-collapse__toggle:hover { background: var(--surface-3); }
.aw-collapse__title { display: inline-flex; align-items: center; gap: 8px; }
.aw-collapse__title i { font-size: 13px; color: var(--primary); }
.aw-collapse__meta { display: inline-flex; align-items: center; gap: 8px; }
.aw-collapse__chevron { font-size: 11px; color: var(--text-3); transition: transform .2s ease; }
.aw-collapse.is-open .aw-collapse__chevron { transform: rotate(180deg); }
.aw-collapse__body { padding: 12px; border-top: 1px solid var(--border); }

/* Disposition pill selector (inside Call Control Desk) */
.aw-disp-pills { display: flex; flex-wrap: wrap; gap: 6px; }
.aw-disp-pill { border: 1px solid var(--border); border-radius: var(--radius-pill); background: var(--surface); color: var(--text-2); font-size: 12px; font-weight: 600; padding: 4px 13px; cursor: pointer; transition: all var(--transition-fast); }
.aw-disp-pill:hover { border-color: var(--primary-border); color: var(--primary); background: var(--primary-soft); }
.aw-disp-pill.is-active { background: var(--primary); border-color: var(--primary); color: #fff; box-shadow: 0 2px 6px rgba(65, 84, 241, .35); }
.aw-disp-pill:disabled { opacity: .55; cursor: not-allowed; }
.aw-disp-pill--invalid { border-color: var(--danger); }

/* ── Student Summary Strip — CRM record header (Salesforce/HubSpot style) ──
   Sits at the top of the profile column, visually separating the student
   identity from the editable tabs below. Never duplicates call controls. */
.aw-summary {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 10px 20px 6px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
}

/* Identity — name + lead id inline, status badge floats far right */
.aw-summary__identity { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; min-width: 0; }
.aw-summary__id { display: flex; align-items: baseline; gap: 8px; min-width: 0; }
.aw-summary__name {
  display: inline-block;
  font-size: 20px; font-weight: 700; line-height: 1.25;
  letter-spacing: -.01em;
  color: var(--text-1);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.aw-summary__ref {
  flex-shrink: 0;
  font-size: 14px; font-weight: 500; color: var(--text-3);
}
.aw-summary__status { flex-shrink: 0; align-self: flex-start; margin-top: 0; }

/* Metadata zones — proportional grids. Email gets the widest share, the
   short-value fields (mobile, dates, country, callback) stay narrow, and
   the long-form email column stretches so it rarely truncates. */
.aw-summary__facts,
.aw-summary__meta {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 8px 20px;
  align-items: start;
}
/* Facts — Mobile ≈1x · Email ≈2x · Lead Source ≈1x · Country ≈0.8x */
.aw-summary__facts {
  grid-template-columns: minmax(110px, 1fr) minmax(140px, 2fr) minmax(110px, 1fr) minmax(90px, 0.8fr);
}
/* Meta — Created ≈0.8x · Updated ≈0.8x · Assigned Agent ≈1x · Callback ≈0.8x */
.aw-summary__meta {
  grid-template-columns: minmax(90px, 0.8fr) minmax(90px, 0.8fr) minmax(110px, 1fr) minmax(90px, 0.8fr);
}
.aw-summary__kv {
  display: flex; flex-direction: column; gap: 1px; min-width: 0;
}
.aw-summary__kv-label {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 12px; font-weight: 500; color: var(--text-3);
  line-height: 1.3;
  white-space: nowrap;
}
.aw-summary__kv-label i { font-size: 11.5px; }
.aw-summary__kv-value {
  font-size: 14px; font-weight: 600; color: var(--text-1);
  line-height: 1.3;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* Meta zone — smaller, muted */
.aw-summary__meta { gap: 8px 20px; }
.aw-summary__kv--sm .aw-summary__kv-label { font-size: 11.5px; }
.aw-summary__kv--sm .aw-summary__kv-label i { font-size: 11px; }
.aw-summary__kv--sm .aw-summary__kv-value { font-size: 13.5px; font-weight: 500; color: var(--text-2); }

/* Empty state — no lead loaded (keeps ref on its own line) */
.aw-summary--empty { border-bottom: 1px dashed var(--border-strong); }
.aw-summary--empty .aw-summary__id { display: block; }
.aw-summary--empty .aw-summary__name { color: var(--text-2); }
.aw-summary--empty .aw-summary__ref { display: block; font-size: 14px; margin-top: 2px; }

/* ── Student Qualification & Profile (right column) ────────────── */
.aw-profile { flex: 1; min-height: 0; display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-xs); overflow: hidden; }
.aw-profile__head { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 20px; border-bottom: 1px solid var(--border); background: var(--surface-2); }
.aw-profile__title { flex: 1; min-width: 0; }
.aw-profile__title h2 { display: flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 700; color: var(--text-1); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.aw-profile__title h2 i { color: var(--primary); }
.aw-profile__title p { font-size: 11.5px; color: var(--text-3); margin: 2px 0 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.aw-profile__meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; flex-shrink: 0; }
.aw-profile__meta-item { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: var(--text-3); white-space: nowrap; }
.aw-profile__meta-item i { font-size: 10.5px; }

/* Call-state badge in the profile header (Ready / Live / Ended / Callback) */
.aw-callstate__timer { font-size: 11px; font-weight: 700; color: inherit; font-variant-numeric: tabular-nums; letter-spacing: .02em; margin-left: 2px; }

/* Tabbed profile sections — compact segmented pills with animated underline */
.aw-tabs { flex-shrink: 0; display: flex; align-items: center; gap: 4px; padding: 6px 20px 10px; border-bottom: 1px solid var(--border); background: var(--surface); }
.aw-tab {
  position: relative;
  display: inline-flex; align-items: center; gap: 7px;
  padding: 7px 14px;
  border: 1px solid transparent;
  border-radius: var(--radius-pill);
  font-size: 12.5px; font-weight: 600; color: var(--text-3);
  background: transparent; cursor: pointer; white-space: nowrap;
  transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
}
.aw-tab i { font-size: 13px; }
.aw-tab:hover { color: var(--text-1); background: var(--surface-2); }
.aw-tab.is-active { color: var(--primary); background: var(--primary-soft); border-color: var(--primary-border); font-weight: 700; }
.aw-tab.is-active i { color: var(--primary); }
.aw-tab::after {
  content: '';
  position: absolute; left: 16px; right: 16px; bottom: -10px;
  height: 2px; border-radius: 2px;
  background: var(--primary);
  transform: scaleX(0); transform-origin: center;
  transition: transform var(--transition);
}
.aw-tab.is-active::after { transform: scaleX(1); }
.aw-tab__count { display: inline-flex; align-items: center; justify-content: center; min-width: 18px; height: 18px; padding: 0 5px; border-radius: var(--radius-pill); background: var(--primary-soft); color: var(--primary); font-size: 10.5px; font-weight: 700; }

/* Editable student profile form */
.aw-profile__body { flex: 1; min-height: 0; overflow-y: auto; padding: 16px 20px 20px; }
.aw-pform { display: flex; flex-direction: column; }
.aw-pform-section { padding: 0; }
.aw-pform-section + .aw-pform-section { border-top: 1px solid var(--border); margin-top: 20px; }
.aw-pform-title {
  display: flex; align-items: center; gap: 8px;
  font-size: 14px; font-weight: 700; letter-spacing: -.01em;
  color: var(--text-1); margin: 0 0 6px;
}
.aw-pform-title i { color: var(--primary); font-size: 14px; }
.aw-pform-title::after { content: ''; flex: 1; height: 1px; background: var(--border); margin-left: 4px; }
.aw-profile .form-label { font-size: 12.5px; font-weight: 600; color: var(--text-2); margin-bottom: 6px; }
.aw-profile .form-control,
.aw-profile .form-select {
  min-height: 44px;
  font-size: 13.5px;
  font-family: var(--font);
  padding: 9px 14px;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius);
  background-color: var(--surface);
  color: var(--text-1);
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);
}
.aw-profile .form-control::placeholder { color: var(--text-3); opacity: .85; }
.aw-profile .form-select { padding: 0 38px 0 14px; }
.aw-profile .form-control:hover,
.aw-profile .form-select:hover { border-color: var(--primary-border); }
.aw-profile .form-control:focus,
.aw-profile .form-select:focus {
  border-color: var(--primary);
  background-color: var(--surface);
  box-shadow: 0 0 0 3px var(--primary-soft);
}
.aw-profile .form-control:disabled,
.aw-profile .form-select:disabled {
  background-color: var(--surface-2);
  color: var(--text-3);
  cursor: not-allowed;
  opacity: .8;
}
.aw-profile__foot {
  flex-shrink: 0; display: flex; align-items: center; justify-content: flex-end; gap: 10px;
  padding: 12px 20px;
  border-top: 1px solid var(--border);
  background: var(--surface-2);
  box-shadow: 0 -4px 12px rgba(0,0,0,.04);
  flex-wrap: wrap;
}
.aw-profile__foot-hint { margin-right: auto; display: inline-flex; align-items: center; gap: 6px; }

/* Student profile form hidden (Callback / RNR / Not Interested) —
   the summary header above stays visible; this fills the empty area. */
.aw-profile__hidden {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center; gap: 10px; padding: 56px 24px; color: var(--text-3);
  min-height: 320px;
}
.aw-profile__hidden i { font-size: 40px; opacity: .35; }
.aw-profile__hidden-title { font-size: 14px; font-weight: 600; color: var(--text-2); margin: 0; }
.aw-profile__hidden-sub { font-size: 13px; color: var(--text-3); max-width: 300px; margin: 0; }

/* Progressive preference cards (Preference 1 first, add 2/3 on demand) */
.aw-prefs { display: flex; flex-direction: column; gap: 12px; }
.aw-pref { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); padding: 12px 14px 14px; }
.aw-pref__head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
.aw-pref__num { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; color: var(--text-2); }
.aw-pref__num i { color: var(--primary); font-size: 13px; }
.aw-pref__remove { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--text-3); font-size: 11px; cursor: pointer; transition: all var(--transition-fast); }
.aw-pref__remove:hover { color: var(--danger); border-color: var(--danger-border); background: var(--danger-soft); }
.aw-pref-add { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 10px 14px; border: 1.5px dashed var(--border-strong); border-radius: var(--radius); background: transparent; color: var(--text-2); font-size: 12.5px; font-weight: 600; cursor: pointer; transition: all var(--transition-fast); }
.aw-pref-add:hover:not(:disabled) { color: var(--primary); border-color: var(--primary-border); background: var(--primary-soft); }
.aw-pref-add:disabled { opacity: .5; cursor: not-allowed; }
.aw-pref-add i { font-size: 13px; }

/* Reference tab */
.aw-ref { display: flex; flex-direction: column; gap: 14px; }
.aw-ref__card { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); padding: 14px 16px; }
.aw-ref__card-title { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: var(--text-1); margin: 0 0 12px; }
.aw-ref__card-title i { color: var(--primary); }
.aw-ref__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.aw-ref__item { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.aw-ref__label { font-size: 11.5px; font-weight: 600; color: var(--text-3); }
.aw-ref__value { font-size: 14px; font-weight: 600; color: var(--text-1); word-break: break-word; }
.aw-ref__empty { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; padding: 40px 20px; color: var(--text-3); border: 1px dashed var(--border-strong); border-radius: var(--radius); }
.aw-ref__empty i { font-size: 28px; opacity: .4; }
.aw-ref__empty-title { font-size: 13.5px; font-weight: 600; color: var(--text-2); margin: 0; }
.aw-ref__empty-sub { font-size: 12px; color: var(--text-3); margin: 0; max-width: 340px; line-height: 1.5; }

/* ── Previous Remarks (bottom of the left control desk column) ─── */
.aw-remarks { flex: 0 0 160px; min-height: 0; display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-xs); overflow: hidden; }
.aw-remarks__head { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 14px; border-bottom: 1px solid var(--border); background: var(--surface-2); }
.aw-remarks__title h2 { display: flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 700; color: var(--text-1); margin: 0; }
.aw-remarks__title h2 i { color: var(--primary); }
.aw-remarks__title p { font-size: 11.5px; color: var(--text-3); margin: 2px 0 0; }
.aw-remarks__body { flex: 1; min-height: 0; overflow-y: auto; padding: 12px 14px; }
.aw-remarks__list { display: flex; flex-direction: column; gap: 10px; }
.aw-remark { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); padding: 10px 12px; }
.aw-remark__top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.aw-remark__time { font-size: 11px; color: var(--text-3); white-space: nowrap; }
.aw-remark__text { font-size: 12.5px; color: var(--text-1); margin: 6px 0 0; white-space: pre-wrap; }
.aw-remark__meta { display: flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 11.5px; color: var(--text-3); }
.aw-remark__meta i { font-size: 11px; }

/* Shared empty / loading states */
.aw-panel-empty { flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 6px; padding: 40px 20px; color: var(--text-3); }
.aw-panel-empty i { width: 56px; height: 56px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; color: var(--primary); background: var(--primary-soft); box-shadow: inset 0 0 0 1px var(--primary-border); margin-bottom: 6px; }
.aw-panel-empty--sm { padding: 24px 16px; }
.aw-panel-empty--sm i { width: 44px; height: 44px; font-size: 17px; }
.aw-panel-empty__title { font-size: 14px; font-weight: 600; color: var(--text-2); margin: 0; }
.aw-panel-empty__sub { font-size: 12.5px; color: var(--text-3); margin: 0; max-width: 300px; }
.aw-panel-loading { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--text-3); padding: 14px 0; }
.aw-panel-loading--pad { padding: 40px 18px; }

/* Skeleton placeholder when no student is loaded */
.aw-profile__skel { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.aw-profile__skel-tabs { flex-shrink: 0; display: flex; align-items: center; gap: 4px; padding: 14px 20px 0; border-bottom: 1px solid var(--border); }
.aw-profile__skel-tabs .sk-line { margin-bottom: 0; }
.aw-profile__skel-body { flex: 1; min-height: 0; overflow: hidden; padding: 16px 20px 20px; display: flex; flex-direction: column; gap: 20px; }
.aw-profile__skel-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.aw-profile__skel-field { display: flex; flex-direction: column; gap: 8px; }
.aw-profile__skel-field .sk-line { margin-bottom: 0; }

/* Responsive */
@media (max-width: 1199.98px) {
  .aw-strip { flex-wrap: wrap; height: auto; padding: 8px 12px; }
  .aw-strip__stats { order: 3; flex-basis: 100%; justify-content: flex-start; overflow-x: auto; }
  .aw-stat { flex-shrink: 0; }
  .aw-ref__grid { grid-template-columns: 1fr; }
}
/* The desk stays a fixed three-column layout on all desktop widths. On
   screens narrower than the combined minimums the columns clip rather
   than reflow, preserving the fixed layout and the "page never scrolls"
   rule. */
@media (max-width: 991.98px) {
  .aw-tabs { overflow-x: auto; }
  .aw-tab { flex-shrink: 0; }
}
@media (max-width: 575.98px) {
  .aw-root { padding: 10px; }
  .aw-main { gap: 10px; }
  .aw-profile__head { flex-direction: column; align-items: flex-start; }
  .aw-profile__body { padding: 14px; }
}

/* --------------------------------------------------------------------------
   15a. AGENT WORKSPACE — fixed three-column desk (Call Dock / Activity)
   -------------------------------------------------------------------------- */

/* Columns fill the full height of the desk; each panel card stretches. */
.aw-col > .ws-panel { flex: 1 1 auto; min-height: 0; }

/* Shared panel card */
.ws-panel { display: flex; flex-direction: column; min-height: 0; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-xs); overflow: hidden; transition: border-color var(--transition-fast), box-shadow var(--transition-fast); }
.ws-panel:hover { border-color: var(--border-strong); box-shadow: var(--shadow-sm); }
.ws-panel__head { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 14px; border-bottom: 1px solid var(--border); background: var(--surface-2); }
.ws-panel__title { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 700; color: var(--text-1); margin: 0; }
.ws-panel__title i { color: var(--primary); font-size: 13.5px; }

/* ── Call Dock (left column) — pure disposition workflow panel ── */
.ws-call__body { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; gap: 10px; padding: 0 12px; overflow: hidden; }

.ws-call__idle { flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 36px 20px; gap: 4px; }
.ws-call__idle-icon { width: 62px; height: 62px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 26px; color: var(--primary); background: var(--primary-soft); box-shadow: inset 0 0 0 1px var(--primary-border); margin-bottom: 12px; }
.ws-call__idle-title { font-size: 16px; font-weight: 700; color: var(--text-1); margin: 0; }
.ws-call__idle-sub { font-size: 12.5px; color: var(--text-3); max-width: 260px; margin: 0; line-height: 1.5; }
.ws-call__fetch { min-width: 172px; margin-top: 16px; }

/* ── Activity panel (right column) ────────────────────────────── */
.ws-activity__head { flex-shrink: 0; display: flex; align-items: center; gap: 4px; padding: 0 16px; border-bottom: 1px solid var(--border); background: var(--surface-2); }
.ws-activity__tabs { flex: 1; min-width: 0; display: flex; align-items: stretch; gap: 2px; overflow-x: auto; }
.ws-activity__tab { position: relative; display: inline-flex; align-items: center; gap: 8px; padding: 11px 14px 12px; font-size: 12.5px; font-weight: 600; color: var(--text-3); background: transparent; border: 0; cursor: pointer; white-space: nowrap; flex-shrink: 0; transition: color var(--transition-fast), background-color var(--transition-fast); }
.ws-activity__tab i { font-size: 13px; }
.ws-activity__tab:hover { color: var(--text-1); background: var(--surface-3); }
.ws-activity__tab.is-active { color: var(--primary); }
.ws-activity__tab.is-active i { color: var(--primary); }
.ws-activity__tab.is-active::after { content: ''; position: absolute; left: 10px; right: 10px; bottom: -1px; height: 2px; border-radius: 2px 2px 0 0; background: var(--primary); }
.ws-activity__body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 12px 14px; }

/* Timeline items render as cards inside the Activity panel */
.ws-activity .timeline { padding-left: 30px; }
.ws-activity .timeline::before { left: 7px; }
.ws-activity .timeline__dot { left: -30px; top: 16px; width: 16px; height: 16px; font-size: 7px; }
.ws-activity .timeline__item { padding: 12px 14px; margin: 0 0 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); transition: border-color var(--transition-fast), box-shadow var(--transition-fast); animation: aw-fade-in .2s ease both; }
.ws-activity .timeline__item:last-child { margin-bottom: 0; }
.ws-activity .timeline__item:hover { border-color: var(--primary-border); box-shadow: var(--shadow-sm); }
.ws-activity .timeline__title { font-size: 13px; font-weight: 700; color: var(--text-1); }
.ws-activity .timeline__detail { font-size: 12.5px; color: var(--text-2); margin-top: 3px; line-height: 1.5; }
.ws-activity .timeline__time { font-size: 11px; font-weight: 600; color: var(--text-3); margin-top: 8px; }

/* Call history rows */
.ws-activity__list { display: flex; flex-direction: column; gap: 8px; }
.ws-history { display: flex; flex-direction: column; gap: 6px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); padding: 10px 12px; transition: border-color var(--transition-fast), box-shadow var(--transition-fast); }
.ws-history:hover { border-color: var(--border-strong); box-shadow: var(--shadow-xs); }
.ws-history__main { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.ws-history__time { font-size: 11px; font-weight: 600; color: var(--text-3); white-space: nowrap; }
.ws-history__meta { display: flex; align-items: center; gap: 12px; font-size: 11.5px; color: var(--text-3); }
.ws-history__meta i { font-size: 11px; }

/* ═══════════════════════════════════════════════════════════════════
   WORK QUEUE DRAWER — slide-out queue panel (Salesforce/HubSpot style)
   ═══════════════════════════════════════════════════════════════════ */
.wq-root { position: fixed; inset: 0; z-index: 1050; background: rgba(11, 17, 29, 0.32); animation: wq-fade .18s ease both; }
.wq-drawer { position: absolute; top: 0; right: 0; bottom: 0; width: 420px; max-width: 92vw; display: flex; flex-direction: column; background: var(--surface); border-left: 1px solid var(--border); box-shadow: var(--shadow-lg); animation: wq-slide .22s ease both; }
.wq-drawer__header { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--border); background: var(--surface-2); }
.wq-drawer__title { display: flex; align-items: center; gap: 9px; font-size: 14.5px; font-weight: 700; color: var(--text-1); margin: 0; min-width: 0; }
.wq-drawer__title-icon { color: var(--primary); }
.wq-drawer__count { display: inline-flex; align-items: center; justify-content: center; min-width: 22px; height: 22px; padding: 0 7px; border-radius: var(--radius-pill); font-size: 12px; font-weight: 700; color: #fff; background: var(--primary); font-variant-numeric: tabular-nums; }
.wq-drawer__body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 14px 16px; }

.wq-view { display: flex; flex-direction: column; gap: 18px; }
.wq-loading { display: inline-flex; align-items: center; gap: 6px; padding: 14px 2px; font-size: 12.5px; color: var(--text-3); }
.wq-loading--foot { justify-content: center; padding: 4px; }
.wq-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; padding: 48px 16px; text-align: center; color: var(--text-3); font-size: 13px; }
.wq-empty i { font-size: 30px; color: var(--text-3); opacity: .6; }

/* ── Groups ──────────────────────────────────────────────────── */
.wq-group { display: flex; flex-direction: column; gap: 8px; }
.wq-group--priority { padding-bottom: 14px; border-bottom: 1px dashed var(--border-strong); }
.wq-group__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.wq-group__label { font-size: 11px; font-weight: 700; color: var(--text-3); text-transform: uppercase; letter-spacing: .05em; }
.wq-group--priority .wq-group__label { color: var(--danger); }
.wq-group__count { font-size: 11px; font-weight: 700; color: var(--text-3); background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-pill); padding: 1px 8px; font-variant-numeric: tabular-nums; }
.wq-group__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }

/* ── Cards ────────────────────────────────────────────────────── */
.wq-card { display: flex; flex-direction: column; gap: 8px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); padding: 12px 13px; box-shadow: var(--shadow-xs); }
.wq-card--active { border-color: var(--primary); background: var(--primary-soft); box-shadow: 0 0 0 2px var(--primary-border); }
.wq-card__top { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; }
.wq-card__name { font-size: 13.5px; font-weight: 700; color: var(--text-1); }
.wq-card__ref { font-size: 11px; color: var(--text-3); font-variant-numeric: tabular-nums; letter-spacing: .02em; flex-shrink: 0; }
.wq-card__meta { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.wq-card__meta-item { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; color: var(--text-2); min-width: 0; }
.wq-card__meta-item i { font-size: 11px; color: var(--text-3); flex-shrink: 0; }
.wq-card__chips { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
.wq-chip { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 600; color: var(--text-2); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-pill); padding: 2px 9px; white-space: nowrap; }
.wq-chip--muted i { font-size: 10px; color: var(--text-3); }
.wq-chip--state { text-transform: uppercase; letter-spacing: .04em; border: 1px solid transparent; }
.wq-chip--danger { color: var(--danger); background: var(--danger-soft); border-color: var(--danger-border); }
.wq-chip--warning { color: #b45309; background: var(--warning-soft); border-color: var(--warning-border); }
.wq-chip--info { color: var(--info); background: var(--info-soft); border-color: var(--info-border); }
.wq-chip--muted { color: var(--text-3); }
.wq-card__due { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 7px; font-size: 11.5px; color: var(--text-2); }
.wq-card__due i { color: var(--text-3); font-size: 11px; }
.wq-card__due strong { font-weight: 700; color: var(--text-1); }
.wq-due { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; border-radius: var(--radius-pill); padding: 1px 8px; color: var(--text-3); background: var(--surface); border: 1px solid var(--border-strong); }
.wq-due--overdue { color: var(--danger); background: var(--danger-soft); border: 1px solid var(--danger-border); }

/* ── Card actions ─────────────────────────────────────────────── */
.wq-card__actions { display: flex; gap: 8px; }
.wq-card__actions .aw-btn { flex: none; min-width: 150px; }
.wq-card__row2 { display: flex; align-items: center; gap: 4px; margin-top: -2px; }
.wq-card__link { font-size: 11.5px; padding: 2px 6px; }
.wq-card__link:disabled { opacity: .45; }
.wq-card__link--done { color: var(--success); }

/* ── Reschedule inline form ───────────────────────────────────── */
.wq-resched { display: flex; flex-direction: column; gap: 8px; border: 1px dashed var(--border-strong); border-radius: var(--radius); padding: 10px 11px; background: var(--surface); }
.wq-resched__fields { display: flex; gap: 8px; }
.wq-resched__field { flex: 1 1 0; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.wq-resched__field span { font-size: 10px; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: .04em; }
.wq-resched__actions { display: flex; justify-content: flex-end; gap: 8px; }

@keyframes wq-slide { from { transform: translateX(100%); } to { transform: translateX(0); } }
@keyframes wq-fade { from { opacity: 0; } to { opacity: 1; } }

@media (max-width: 575.98px) {
  .wq-drawer { width: 100vw; max-width: 100vw; }
  .wq-resched__fields { flex-direction: column; }
}

/* ═══════════════════════════════════════════════════════════════════
   ASSIGNED LEADS DRAWER — primary agent workload view (KPI → drawer)
   ═══════════════════════════════════════════════════════════════════ */
.ald { display: flex; flex-direction: column; gap: 12px; }

/* Search */
.ald__search { position: relative; }
.ald__search-icon { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); font-size: 13px; color: var(--text-3); }
.ald__search-input { padding-left: 32px; padding-right: 30px; font-size: 12.5px; }
.ald__search-clear { position: absolute; right: 2px; top: 50%; transform: translateY(-50%); padding: 2px 6px; color: var(--text-3); }

/* Filters */
.ald__filters { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
.ald__filters .form-select { font-size: 12px; }
.ald__reset { grid-column: 1 / -1; font-size: 12px; }
.ald__preset-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: -4px; }
.ald__chip-x { display: inline-flex; align-items: center; justify-content: center; padding: 0; margin-left: 2px; border: none; background: none; color: inherit; font-size: 12px; line-height: 1; cursor: pointer; opacity: .7; }
.ald__chip-x:hover { opacity: 1; }

/* Summary + live indicator */
.ald__summary { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 11.5px; font-weight: 600; color: var(--text-3); }
.ald__refreshing { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--text-3); }
.ald__refreshing .spinner-border { width: 10px; height: 10px; }

/* Rows */
.ald__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.ald-row { display: flex; flex-direction: column; gap: 9px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); padding: 12px 13px; box-shadow: var(--shadow-xs); }
.ald-row__top { display: flex; align-items: center; gap: 10px; min-width: 0; }
.ald-row__who { flex: 1; min-width: 0; }
.ald-row__name { font-size: 13px; font-weight: 700; color: var(--text-1); }
.ald-row__meta { font-size: 11px; color: var(--text-3); margin-top: 1px; font-variant-numeric: tabular-nums; }
.ald-row__status { flex-shrink: 0; font-size: 10px; font-weight: 700; }
.ald-row__chips { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
.ald-row__foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.ald-row__time { display: inline-flex; align-items: center; gap: 6px; font-size: 10.5px; color: var(--text-3); white-space: nowrap; }
.ald-row__time i { font-size: 10px; color: var(--text-3); }
.ald-row__cta { flex-shrink: 0; white-space: nowrap; font-size: 12px; }

/* Pagination */
.ald__pager { display: flex; justify-content: flex-end; border-top: 1px solid var(--border); padding-top: 10px; }

@media (max-width: 575.98px) {
  .ald__filters { grid-template-columns: 1fr; }
  .ald__reset { grid-column: auto; }
}

/* ═══════════════════════════════════════════════════════════════════
   IMPORT LEADS — upload → validate/preview → import → summary
   ═══════════════════════════════════════════════════════════════════ */
.il-body { display: flex; flex-direction: column; gap: 16px; }

.il-drop {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 34px 20px;
  border: 1.5px dashed var(--border-strong);
  border-radius: var(--radius-lg);
  background: var(--surface-2);
  text-align: center;
  cursor: pointer;
  transition: border-color var(--transition-fast), background var(--transition-fast);
}
.il-drop:hover, .il-drop.is-dragging { border-color: var(--primary); background: var(--primary-soft); }
.il-drop__icon { font-size: 30px; color: var(--primary); }
.il-drop__title { font-size: 14.5px; font-weight: 600; color: var(--text-1); margin: 0; }
.il-drop__sub { font-size: 12px; color: var(--text-3); margin: 0; }
.il-drop__hint { font-size: 11.5px; color: var(--text-3); margin: 2px 0 0; }
.il-drop .aw-btn { margin-top: 2px; }

.il-tools { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 0 2px; }

.il-section { border-top: 1px solid var(--border); padding-top: 14px; }
.il-section__label {
  font-size: 11px; font-weight: 700; color: var(--text-3);
  text-transform: uppercase; letter-spacing: .06em; margin-bottom: 8px;
}
.il-option {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 9px 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface-2);
  cursor: pointer;
  transition: border-color var(--transition-fast), background var(--transition-fast);
}
.il-option:hover { border-color: var(--primary-border); }
.il-option.is-selected { border-color: var(--primary); background: var(--primary-soft); }
.il-option input { margin-top: 3px; accent-color: var(--primary); }
.il-option__text { display: flex; flex-direction: column; gap: 1px; }
.il-option__title { font-size: 13px; font-weight: 600; color: var(--text-1); }
.il-option__sub { font-size: 11.5px; color: var(--text-3); }

.il-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px; }
.il-stat {
  display: flex; flex-direction: column; gap: 2px;
  padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius);
  background: var(--surface-2);
}
.il-stat__num { font-size: 22px; font-weight: 700; line-height: 1.1; color: var(--text-1); font-variant-numeric: tabular-nums; }
.il-stat__label { font-size: 11px; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: .05em; }
.il-stat.is-valid { border-color: var(--success-border); background: var(--success-soft); }
.il-stat.is-valid .il-stat__num { color: var(--success); }
.il-stat.is-info { border-color: var(--info-border); background: var(--info-soft); }
.il-stat.is-info .il-stat__num { color: var(--info); }
.il-stat.is-dup { border-color: var(--warning-border); background: var(--warning-soft); }
.il-stat.is-dup .il-stat__num { color: var(--warning); }
.il-stat.is-invalid { border-color: var(--danger-border); background: var(--danger-soft); }
.il-stat.is-invalid .il-stat__num { color: var(--danger); }

.il-grid-wrap {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  max-height: 300px;
  overflow-y: auto;
}
.il-grid-wrap .e-table thead th { position: sticky; top: 0; z-index: 1; }
.il-grid-wrap .e-table td { white-space: nowrap; }

.il-progress { height: 8px; border-radius: var(--radius-pill); background: var(--surface-2); overflow: hidden; }
.il-progress__bar {
  width: 40%;
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--primary);
  animation: il-slide 1.1s ease-in-out infinite;
}
@keyframes il-slide {
  0% { margin-left: -40%; }
  100% { margin-left: 100%; }
}
.il-import-title { font-size: 14.5px; font-weight: 600; color: var(--text-1); margin: 0; }
